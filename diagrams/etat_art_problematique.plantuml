@startuml

left to right direction
skinparam packageStyle rectangle

rectangle "Système actuel (manuel / dispersé)" {

  usecase "Excel / fichiers dispersés" as A1
  usecase "Données non centralisées" as A2
  usecase "Suivi des dossiers difficile" as A3
  usecase "Risque de perte d'information" as A4
}

rectangle "Solution M-Motors" {

  usecase "Base de données centralisée" as B1
  usecase "Gestion unifiée des véhicules" as B2
  usecase "Workflow dossier client structuré" as B3
  usecase "Traçabilité et historique" as B4
  usecase "Interface web centralisée" as B5
}

A1 ..> B1 : remplacement
A2 ..> B2 : amélioration
A3 ..> B3 : solution
A4 ..> B4 : correction

@enduml