{% extends 'base.html.twig' %}

{% block title %}
    M-Motors: Formulaire d'inscription
{% endblock %}

{% block body %}
    <h1 class="text-center"><i class="fa-solid fa-user-plus title-icon"></i>Formulaire d'inscription</h1>

    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">
            {{ flash_error }}
        </div>
    {% endfor %}
<div class="form-ui"data-ajax-modal>
    {{ form_start(registrationForm, {'attr': {'id': 'registrationForm'}}) }}

    <div class="alert alert-warning">
        <strong>🔐 Attention: Sécurisation obligatoire de votre compte</strong><br>
        <p>
            Après votre inscription, vous devrez configurer l'authentification à deux facteurs (2FA)
            pour pouvoir vous connecter.
        </p>
    </div>

    <div class="form-row mb-3">
        {{ form_row(registrationForm.email) }}
    </div>

    <div class="form-row mb-3 position-relative">
        <div id="strength-bar"
             style="position:relative; width:100%; height:8px; background:#ddd; border-radius:4px; margin-top:4px;">
            <div id="strength-fill"
                 style="height:100%; width:0; border-radius:4px; transition:width 0.3s;">
            </div>
        </div>
    </div>

    <div class="form-row">
        {{ form_row(registrationForm.plainPassword) }}
    </div>

    <div id="password-indicators" class="form-row password-rules" style="font-size:0.85em;">
        
    <div id="length-indicator" class="password-rule invalid">
        ✖ Au moins 8 caractères
    </div>

    <div id="lower-indicator" class="password-rule invalid">
        ✖ Au moins une lettre minuscule
    </div>

    <div id="upper-indicator" class="password-rule invalid">
        ✖ Au moins une lettre majuscule
    </div>

    <div id="digit-indicator" class="password-rule invalid">
        ✖ Au moins un chiffre
    </div>

    <div id="special-indicator" class="password-rule invalid">
        ✖ Au moins un caractère spécial (!@#$%^&*)
    </div>
</div>


    <p id="strength-text" class="mt-1 mb-0" style="font-size:0.9em;"></p>

    <div class="checkbox-row mb-2">
        {{ form_widget(registrationForm.agreeTerms) }}
        {{ form_label(registrationForm.agreeTerms) }}
        {{ form_errors(registrationForm.agreeTerms) }}
    </div>

    <div class="checkbox-row mb-3">
        {{ form_widget(registrationForm.accept2fa) }}
        {{ form_label(registrationForm.accept2fa) }}
        {{ form_errors(registrationForm.accept2fa) }}
    </div>

    <button type="submit" class="btn" id="submit-btn">
        S'inscrire
    </button>

    <p class="form-footer mt-2">
        Déjà inscrit ?
        <a href="{{ path('app_login') }}">
            Cliquez ici pour vous connecter
        </a>
    </p>

    {{ form_end(registrationForm) }}
</div>


    <script>
    console.log("js form register initialisé")
       const passwordInput = document.getElementById('registration_form_plainPassword');
const strengthFill = document.getElementById('strength-fill');
const strengthText = document.getElementById('strength-text');
const submitBtn = document.getElementById('submit-btn');

const indicators = {
    length: document.getElementById('length-indicator'),
    lower: document.getElementById('lower-indicator'),
    upper: document.getElementById('upper-indicator'),
    digit: document.getElementById('digit-indicator'),
    special: document.getElementById('special-indicator')
};

passwordInput.addEventListener('input', updateStrength);

function setValid(el, text) {
    el.classList.remove('invalid');
    el.classList.add('valid');
    el.textContent = text;
}

function setInvalid(el, text) {
    el.classList.remove('valid');
    el.classList.add('invalid');
    el.textContent = text;
}

function updateStrength() {
    const password = passwordInput.value;
    let score = 0;

    // Longueur
    if (password.length >= 8) {
        score += 25;
        setValid(indicators.length, '✔ Au moins 8 caractères');
    } else {
        setInvalid(indicators.length, '✖ Au moins 8 caractères');
    }

    // Minuscule
    if (/[a-z]/.test(password)) {
        score += 15;
        setValid(indicators.lower, '✔ Au moins une lettre minuscule');
    } else {
        setInvalid(indicators.lower, '✖ Au moins une lettre minuscule');
    }

    // Majuscule
    if (/[A-Z]/.test(password)) {
        score += 20;
        setValid(indicators.upper, '✔ Au moins une lettre majuscule');
    } else {
        setInvalid(indicators.upper, '✖ Au moins une lettre majuscule');
    }

    // Chiffre
    if (/\d/.test(password)) {
        score += 20;
        setValid(indicators.digit, '✔ Au moins un chiffre');
    } else {
        setInvalid(indicators.digit, '✖ Au moins un chiffre');
    }

    // Caractère spécial
    if (/[!@#$%^&*]/.test(password)) {
        score += 20;
        setValid(indicators.special, '✔ Au moins un caractère spécial (!@#$%^&*)');
    } else {
        setInvalid(indicators.special, '✖ Au moins un caractère spécial (!@#$%^&*)');
    }

    if (score > 100) {
        score = 100;
    }

    // Barre de progression
    strengthFill.style.width = score + '%';

    if (score < 60) {
        strengthFill.style.backgroundColor = 'red';
        strengthText.textContent = `Complexité faible (${score}%) – minimum 60% requis`;
        submitBtn.disabled = true;
    } else if (score < 80) {
        strengthFill.style.backgroundColor = 'orange';
        strengthText.textContent = `Complexité moyenne (${score}%)`;
        submitBtn.disabled = false;
    } else {
        strengthFill.style.backgroundColor = 'green';
        strengthText.textContent = `Complexité élevée (${score}%)`;
        submitBtn.disabled = false;
    }
}

// Initial check
updateStrength();
    </script>
{% endblock %}