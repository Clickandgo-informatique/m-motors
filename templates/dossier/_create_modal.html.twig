{% block body %}
	<div class="form-ui">
		<div class="modal-header">
			<h1 class="modal-title text-center">
				<i class="fa-solid fa-folder title-icon"></i>
				Créer un dossier
			</h1>

			<button type="button" data-modal-close class="modal-close"></button>
		</div>

		<div class="modal-content">

			<h3>
				{{ vehicle.vehicleModel.brand.name }}
				{{ vehicle.vehicleModel.model.name }}
			</h3>

			<form method="post" action="{{ path('dossier_create', { id: vehicle.id }) }}">

				<input
				type="hidden" name="_token" value="{{ csrf_token('create_dossier') }}">

				{# TYPE DE DOSSIER #}
				<div class="form-row">
					<label>Type de dossier</label>

					{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}

						<select name="type" class="form-control">
							<option value="rental" {% if type == 'rental' %} selected {% endif %}>
								Location
							</option>
							<option value="purchase" {% if type == 'purchase' %} selected {% endif %}>
								Achat
							</option>
						</select>

					{% else %}

						{% if vehicle.usageType.value == 'both' %}

							<select name="type" class="form-control" required>
								<option value="rental">Location</option>
								<option value="purchase">Achat</option>
							</select>

						{% else %}

							<input type="hidden" name="type" value="{{ vehicle.usageType.value == 'rent' ? 'rental' : 'purchase' }}">

							<p>
								type :
								<strong>
									{{ vehicle.usageType.value == 'rent' ? 'location' : 'achat' }}
								</strong>
							</p>

						{% endif %}

					{% endif %}
				</div>

				{# CLIENT #}
				{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}

					<label>Client</label>

					{% include 'Components/Forms/_fetch_form.html.twig' with {
                    action: path('customer_search'),
                    fetchUrl: path('customer_search'),
                    autocompleteUrl: path('customer_search'),
                    resultDiv: 'customer_results',
                    name: 'q',
                    placeholder: 'rechercher un client',
                    linkMode: '0',
                    fetchMode: 'json',
                    hiddenName: 'customerId',
                    baseUrl: '/customer/'
                } %}

				{% else %}

					<input type="hidden" name="customerId" value="{{ app.user.customer.id }}">

					<p>
						client :
						<strong>{{ app.user.customer.fullName }}</strong>
					</p>

				{% endif %}

				<div class="modal-footer-actions">

					<button type="submit" class="btn btn-success">
						<i class="fa-solid fa-check"></i>
						Confirmer
					</button>

					<button type="button" class="btn btn-cancel" data-modal-close>
						Annuler
					</button>

				</div>

			</form>
		</div>
	</div>
{% endblock %}
