{# modale unique de création de dossier depuis un véhicule #}
{% block body %}
	<div class="form-ui">
		<div class="modal-header">
			<h1 class="modal-title text-center">
				<i class="fa-solid fa-folder title-icon"></i>Créer un dossier</h1>

			<button type="button" data-modal-close class="modal-close"></button>
		</div>

		<div class="modal-content">

			<h3>
				{{ vehicle.vehicleModel.brand.name }}
				{{ vehicle.vehicleModel.model.name }}
			</h3>

			<p>
				type :
				{{ type == 'rental' ? 'location' : 'achat' }}
			</p>

			<form method="post" action="{{ path('dossier_create', { id: vehicle.id, type: type }) }}">

				<input
				type="hidden" name="_token" value="{{ csrf_token('create_dossier') }}">

				{# type de dossier #}
				{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
					<div class="form-row">
						<label>Type de dossier</label>

						<select name="type" class="form-control">
							<option value="rental" {{ type == 'rental' ? 'selected' : '' }}>location</option>
							<option value="purchase" {{ type == 'purchase' ? 'selected' : '' }}>achat</option>
						</select>
					</div>
				{% else %}

					<input type="hidden" name="type" value="{{ type }}">

				{% endif %}

				{# client #}
				{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}

					<label>client</label>

					{% include 'Components/Forms/_fetch_form.html.twig' with {
                action: path('customer_search'),
                fetchUrl: path('customer_search'),
                autocompleteUrl: path('customer_search'),
                resultDiv: 'customer_results',
                name: 'q',
                placeholder: 'rechercher un client',
                linkMode: '0',
                fetchMode: 'json',
                hiddenName: 'customerId',
                baseUrl: '/customer/'
            } %}

				{% else %}

					<input type="hidden" name="customerId" value="{{ app.user.customer.id }}">

					<p>
						client :
						<strong>{{ app.user.customer.fullName }}</strong>
					</p>

				{% endif %}

				<div class="modal-footer-actions">

					<button type="submit" class="btn btn-success">
						<i class="fa-solid fa-check"></i>Confirmer
					</button>

					<button type="button" class="btn btn-cancel" data-modal-close>
						<i class="fa-solid fa-cancel"></i>Annuler
					</button>

				</div>
			</form>
		</div>
	</div>
{% endblock %}
