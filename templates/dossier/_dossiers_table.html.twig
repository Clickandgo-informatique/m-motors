<table class="table table-hover mt-3">

	<thead>
		<tr>
			<th>Référence</th>
			<th>Véhicule</th>
			<th>Client</th>
			<th>Type</th>
			<th>Immatriculation</th>
			<th>VIN</th>
			<th>Statut</th>
			<th>Date</th>
			<th></th>
		</tr>
	</thead>

	<tbody>
		{% for dossier in dossiers %}
			<tr>

				<td data-label="Référence">
					{{ dossier.dossierCode }}
				</td>

				<td data-label="Véhicule">
					{{ dossier.vehicle.vehicleModel }}
				</td>

				<td data-label="Client">
					{{ dossier.customer }}
				</td>

				<td data-label="Type">
					{{ dossier.type.label }}
				</td>

				<td data-label="Immatriculation">
					{{ dossier.vehicle.registrationNumber }}
				</td>

				<td data-label="VIN">
					{{ dossier.vehicle.vin }}
				</td>

				<td data-label="Statut">
					<span class="badge bg-{{ dossier.statusBadge }}">
						{{ dossier.statusLabel }}
					</span>
				</td>

				<td data-label="Date">
					{{ dossier.createdAt|date('d/m/Y') }}
				</td>

				<td data-label="">
					<a href="{{ path('admin_dossier_show', {id: dossier.id}) }}"
					   class="btn btn-sm btn-dark">
						Gérer
					</a>
				</td>

			</tr>
		{% endfor %}
	</tbody>

</table>