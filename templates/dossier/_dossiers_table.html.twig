<div class="dossier-cards">

    {% for dossier in dossiers %}

        <div class="dossier-card card">

            <div class="dossier-card-header">

                <div class="dossier-card-actions">
                    <a href="{{ path('admin_dossier_show', {id: dossier.id}) }}"
                       class="btn btn-sm btn-dark">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a>
                </div>

                <div class="dossier-card-status">
                    <span class="badge bg-{{ dossier.statusBadge }}">
                        {{ dossier.statusLabel }}
                    </span>
                </div>

                <div class="dossier-card-date">
                    {{ dossier.createdAt|date('d/m/Y') }}
                </div>

            </div>

            <div class="dossier-card-body">

                <div class="dossier-card-main">

                    <h3 class="dossier-vehicle">
                        {{ dossier.vehicle.vehicleModel }}
                    </h3>

                    <div class="dossier-reference">
                        {{ dossier.dossierCode }}
                    </div>

                </div>

                <div class="dossier-card-grid">

                    <div class="dossier-item">
                        <span class="label">Client</span>
                        <span class="value">{{ dossier.customer }}</span>
                    </div>

                    <div class="dossier-item">
                        <span class="label">Type</span>
                        <span class="value">{{ dossier.type.label }}</span>
                    </div>

                    <div class="dossier-item">
                        <span class="label">Immatriculation</span>
                        <span class="value">
                            {{ dossier.vehicle.registrationNumber ?: 'Non renseignée' }}
                        </span>
                    </div>

                    <div class="dossier-item">
                        <span class="label">VIN</span>
                        <span class="value">
                            {{ dossier.vehicle.vin ?: 'Non renseigné' }}
                        </span>
                    </div>

                </div>

            </div>

        </div>

    {% endfor %}

</div>