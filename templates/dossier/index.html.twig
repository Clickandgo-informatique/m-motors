{% extends 'base.html.twig' %}

{% block title %}Mes dossiers
{% endblock %}

{% block body %}

	<div class="container mt-4 table-wrapper">

		<h1>Mes dossiers</h1>

		<table class="table table-striped mt-3">

			<thead>
				<tr>
					<th>Référence</th>
					<th>Véhicule</th>
					<th>Type</th>
					<th>Statut</th>
					<th>Date</th>
					<th></th>
				</tr>
			</thead>

			<tbody>
				{% for dossier in dossiers %}
					<tr>
						<td data-label="Référence">{{ dossier.dossierCode }}</td>
						<td data-label="Référence">{{ dossier.vehicle.vehicleModel }}</td>
						<td data-label="Type">{{ dossier.type.label }}</td>
						<td data-label="Statut">
							<span class="badge bg-{{ dossier.status.badge }}">
								{{ dossier.status.label }}
							</span>
						</td>
						<td data-label="Créé le">{{ dossier.createdAt|date('d/m/Y') }}</td>
						<td>
							<a href="{{ path('dossier_show', {id: dossier.id}) }}" class="btn btn-sm btn-primary">
								<i class="fa-solid fa-folder-open"></i>Voir
							</a>
						</td>
					</tr>
				{% endfor %}
			</tbody>

		</table>

	</div>

{% endblock %}
