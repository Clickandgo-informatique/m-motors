{% extends 'base.html.twig' %}

{% block title %}Mes dossiers
{% endblock %}

{% block body %}

	<div class="container mt-4 table-wrapper">

		<h1 class="text-center"><i class="fa-regular fa-folder title-icon"></i>Mes dossiers</h1>

		<table class="table table-striped mt-3">

			<thead>
				<tr>
					<th></th>
					<th>Référence</th>
					<th>Véhicule</th>
					<th>Type</th>
					<th>Statut</th>
					<th>Date</th>
					<th></th>
				</tr>
			</thead>

			{% if dossiers is defined and dossiers|length >0 %}
			<tbody>
			
				{% for dossier in dossiers %}
					<tr>
						<td>
							<div class="dossier-item dossier-item-image">
								<img src="{{ asset('uploads/' ~ dossier.vehicle.images|first.imagePath) }}" alt="{{ dossier.vehicle.vehicleModel.brand.name }} {{ dossier.vehicle.vehicleModel.model.name }}" class="vehicle-image-thumbnail" loading="lazy">
							</div>
						</td>

						<td data-label="Référence">{{ dossier.dossierCode }}</td>
						<td data-label="Référence">{{ dossier.vehicle.vehicleModel }}</td>
						<td data-label="Type">{{ dossier.type.label }}</td>
						<td data-label="Statut">
							<span class="badge bg-{{ dossier.status.badge }}">
								{{ dossier.status.label }}
							</span>
						</td>
						<td data-label="Créé le">{{ dossier.createdAt|date('d/m/Y') }}</td>
						<td>
							<a href="{{ path('dossier_show', {id: dossier.id}) }}" class="btn btn-sm btn-primary">
								<i class="fa-solid fa-folder-open"></i>Voir
							</a>
						</td>
					</tr>
				{% endfor %}
			</tbody>
				{% else %}
					<p class="text-center">Il n'existe encore aucun dossier.</p>
				{% endif %}

		</table>

	</div>

{% endblock %}
