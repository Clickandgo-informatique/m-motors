{% set logs = dossier.workflowLogs|sort((a, b) => a.createdAt <=> b.createdAt) %}
{% set statuses = statuses|reduce((carry, s) => carry|merge({ (s.value): s }), {}) %}

{% set current = statuses[currentStatus] ?? null %}

<div class="card mb-3">
	<div class="card-body">

		<h5 class="mb-3">Suivi du dossier</h5>

		<ul class="timeline list-unstyled m-0">

			{% for status in statuses %}

				{% set reached = false %}
				{% set isCurrent = current and status.value == current.value %}

				{# check si cette étape est atteinte via logs #}
				{% for log in logs %}
					{% if log.toStatus == status.value %}
						{% set reached = true %}
					{% endif %}
				{% endfor %}

				<li class="timeline-item
											{{ reached ? 'done' : '' }}
											{{ isCurrent ? 'active' : '' }}
											{{ current and current.isFinal() and isCurrent ? 'final' : '' }}
										">

					<div class="timeline-icon">
						<i class="{{ status.icon() }}"></i>
					</div>

					<div class="timeline-content">

						<strong>{{ status.label() }}</strong>

						<div class="text-muted small">
							{% if isCurrent %}
								Étape actuelle
							{% elseif reached %}
								Terminé
							{% else %}
								En attente
							{% endif %}
						</div>

					</div>

				</li>

			{% endfor %}

		</ul>

	</div>
</div>
