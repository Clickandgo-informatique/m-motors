{# timeline CRM stable basée sur audit #}

{% set logs = dossier.workflowLogs|sort((a, b) => a.createdAt <=> b.createdAt) %}

{% set labels = {
    'create': {
        label: 'Dossier créé',
        icon: 'fa-solid fa-file-circle-plus'
    },
    'select_vehicle': {
        label: 'Véhicule sélectionné',
        icon: 'fa-solid fa-car'
    },
    'request_documents': {
        label: 'Documents demandés',
        icon: 'fa-solid fa-folder-open'
    },
    'submit_documents': {
        label: 'Documents soumis',
        icon: 'fa-solid fa-upload'
    },
    'validate_documents': {
        label: 'Documents validés',
        icon: 'fa-solid fa-circle-check'
    },
    'approve_financing': {
        label: 'Financement validé',
        icon: 'fa-solid fa-handshake'
    },
    'sign_order': {
        label: 'Commande signée',
        icon: 'fa-solid fa-pen-nib'
    },
    'cancel': {
        label: 'Dossier annulé',
        icon: 'fa-solid fa-circle-xmark'
    }
} %}

<div class="card mb-3">
	<div class="card-body">

		<h5 class="mb-3">Timeline du dossier</h5>

		<ul class="timeline list-unstyled m-0">

			{% for log in logs %}

				{% set config = labels[log.transition] ?? {
                    label: log.transition,
                    icon: 'fa-solid fa-circle'
                } %}

				<li class="timeline-item">

					<div class="timeline-icon">
						<i class="{{ config.icon }}"></i>
					</div>

					<div class="timeline-content">

						<strong>{{ config.label }}</strong>

						<div class="text-muted small">
							{{ log.createdAt|date('d/m/Y H:i') }}
						</div>

						<div class="text-muted small">
							{{ log.fromStatus }}
							→
							{{ log.toStatus }}
						</div>

					</div>

				</li>

			{% endfor %}

		</ul>

	</div>
</div>
