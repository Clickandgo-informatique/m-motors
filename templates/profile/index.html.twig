{% extends "base.html.twig" %}

{% block title %}Profil de
	{{ app.user.nickname }}
{% endblock %}

{% block body %}

	<h1 class="text-center">
		<i class="fa-regular fa-address-card"></i>Mon profil</h1>

	<p class="text-center">Pseudo enregistré :
		{{ (app.user.nickname)? app.user.nickname: 'Aucun' }}</p>
	<p class="text-center">Email :
		{{ app.user.email }}</p>
	<p class="text-center">Rôles :
		{{ app.user.roles|join(', ') }}</p>

	{% if app.user.is2FAEnabled %}
		<p class="text-center">
			<i class="fa-solid fa-shield-halved"></i> L'authentification à double facteur est activée sur votre compte.</p>
		{# <a href="{{ path('app_2fa_disable') }}" class="btn btn-danger">Désactiver le 2FA</a> #}
	{% endif %}


{% endblock %}
