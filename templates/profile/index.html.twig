{% extends "base.html.twig" %}

{% block title %}
    Profil de
    {{ app.user
        ? (app.user.nickname
            ? app.user.nickname
            : (app.user.lastName ~ ' ' ~ app.user.firstName)
          )
        : 'invité'
    }}
{% endblock %}

{% block body %}

    <h1 class="text-center">
        <i class="fa-regular fa-address-card"></i> Mon profil
    </h1>

    <p class="text-center">
        Pseudo enregistré :
        {{ app.user
            ? (app.user.nickname ?: 'Aucun')
            : 'Aucun'
        }}
    </p>

    <p class="text-center">
        Email :
        {{ app.user ? app.user.email : 'Non disponible' }}
    </p>

    <p class="text-center">
        Rôles :
        {{ app.user ? app.user.roles|join(', ') : 'Aucun rôle' }}
    </p>

    {% if app.user and app.user.is2FAEnabled %}
        <p class="text-center">
            <i class="fa-solid fa-shield-halved"></i>
            L'authentification à double facteur est activée sur votre compte.
        </p>
    {% endif %}

{% endblock %}