<aside class="sidebar" id="sidebar">

	<button id="sidebar-toggle" class="sidebar-handle">
		<i class="fa-solid fa-chevron-left"></i>
	</button>

	<nav
		class="sidenav sidenav-filters" aria-label="Navigation latérale">

		{# ========================= VEHICULES ========================= #}
		<details open>
			<summary>
				<i class="fa-solid fa-car-side"></i>
				<span>Véhicules</span>
			</summary>

			<ul class="items-list">

				<li>
					<a href="{{ path('vehicles_index') }}">
						<i class="fa-solid fa-car-tunnel"></i>
						Véhicules enregistrés
					</a>
				</li>

				{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
					<li>
						<a href="{{ path('vehicles_models') }}">
							<i class="fa-solid fa-book"></i>
							Catalogue fabricants
						</a>
					</li>

					<li>
						<a href="{{ path('vehicle_new') }}">
							<i class="fa-solid fa-file-circle-plus"></i>
							Créer un véhicule
						</a>
					</li>

					<li>
						<a href="{{ path('vehicle_model_new') }}">
							<i class="fa-solid fa-file-circle-plus"></i>
							Créer un modèle de véhicule
						</a>
					</li>
				{% endif %}

			</ul>

			{# ========================= FILTRES VEHICULES ========================= #}
			{% if app.request.attributes.get('_route') starts with 'vehicles' %}
				<div id="vehicles-filters">
					{{ render(controller(
						'App\\Controller\\VehiclesFilterController::sidebarFilters'
					)) }}
				</div>
			{% endif %}

		</details>

		{# ========================= CLIENTS ========================= #}
		{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
			<details open>
				<summary>
					<i class="fa-regular fa-address-book"></i>
					Clients
				</summary>

				<ul class="items-list">

					<li>
						<a href="{{ path('customer_list') }}">
							<i class="fa-regular fa-address-book"></i>
							Liste clients
						</a>
					</li>

					<li>
						<a href="{{ path('customer_new') }}">
							<i class="fa-solid fa-user-plus"></i>
							Créer client
						</a>
					</li>

				</ul>
			</details>
		{% endif %}

		{# ========================= DOSSIERS ========================= #}
		{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
			<details open>
				<summary>
					<i class="fa-solid fa-file-lines"></i>
					Dossiers
				</summary>

				<ul class="items-list">

					<li>
						<a href="{{ path('admin_dossier_list') }}">
							<i class="fa-solid fa-list"></i>
							Liste dossiers (Admin)
						</a>
					</li>

					<li>
						<a href="{{ path('admin_dossier_new') }}">
							<i class="fa-solid fa-file-circle-plus"></i>
							Créer dossier
						</a>
					</li>

				</ul>

				{% if app.user %}
					<ul class="items-list">
						<li>
							<a href="{{ path('dossier_user_list') }}">
								<i class="fa-solid fa-folder-open"></i>
								Mes dossiers
							</a>
						</li>
					</ul>
				{% endif %}

			</details>
		{% endif %}

	</nav>
</aside>
