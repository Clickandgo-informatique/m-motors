{# templates/partials/_sidebar.html.twig #}
<aside
	class="sidebar" id="sidebar">
	{# Bouton pour ouvrir/fermer la sidebar #}
	<button id="sidebar-toggle" class="sidebar-handle">
		<i class="fa-solid fa-chevron-left"></i>
	</button>

	<nav class="sidenav" aria-label="Navigation latérale">
		<details>
			<summary>
				<i class="fa-solid fa-car-side"></i>
				<span>Véhicules</span>
			</summary>
			<ul class="items-list">
				{% if is_granted ('ROLE_ADMIN') or is_granted('ROLE_MANAGER')%}

					<li>
						<a href="{{path('vehicles_models')}}">
							<i class="fa-solid fa-book"></i>Catalogue fabricants</a>
					</li>
					<li>
						<a href="{{path('vehicle_model_new')}}">
							<i class="fa-solid fa-file-circle-plus"></i>Créer un modèle de véhicule</a>
					</li>
				{% endif %}
				<li>
					<a href="{{path('vehicles')}}">
						<i class="fa-solid fa-car-tunnel"></i>Véhicules enregistrés</a>
				</li>

			</ul>
		</details>
		<details>
			<summary>
				<i class="fa-regular fa-address-book"></i>Clients
				</summary>
				<ul class="items-list">
				<li><a href="#"><i class="fa-regular fa-address-book"></i>Liste clients</a></li>
				<li><a href="#"><i class="fa-solid fa-user-plus"></i>Créer client</a></li>
				</ul>
		</details>
	</nav>

	{# Include filtres uniquement si on est sur la page vehicles #}
	{% if app.request.attributes.get('_route') starts with 'vehicles' %}
		{{ render(controller(
        'App\\Controller\\VehiclesFilterController::getFilters'
    )) }}
	{% endif %}
</aside>
