<aside class="sidebar" id="sidebar">

    <button
        id="sidebar-toggle"
        class="sidebar-handle"
        type="button"
        aria-label="toggle navigation"
    >
        <i class="fa-solid fa-chevron-left"></i>
    </button>

    <nav class="sidenav sidenav-filters" aria-label="navigation laterale">

        {% set currentRoute = app.request.attributes.get('_route') %}

        {% set vehiclesRoutes = currentRoute starts with 'vehicle' or currentRoute starts with 'vehicles_' %}
        {% set customersRoutes = currentRoute starts with 'customer_' %}
        {% set dossiersRoutes = currentRoute starts with 'admin_dossier_' %}

        {% if app.user and (is_granted('ROLE_USER') or is_granted('ROLE_CUSTOMER')) %}

            <ul class="items-list standalone-links">

                <li>
                    <a
                        href="{{ path('dossier_user_list') }}"
                        class="{% if currentRoute == 'dossier_user_list' %}is-active{% endif %}"
                    >
                        <i class="fa-solid fa-folder-open"></i>
                        <span>Mes dossiers</span>
                    </a>
                </li>

            </ul>

        {% endif %}

        <details class="sidebar-group {% if vehiclesRoutes %}is-active{% endif %}" {% if vehiclesRoutes %}open{% endif %}>

            <summary>
                <i class="fa-solid fa-car-side"></i>
                <span>vehicules</span>
            </summary>

            <ul class="items-list">

                <li>
                    <a
                        href="{{ path('vehicles_index') }}"
                        class="{% if currentRoute == 'vehicles_index' %}is-active{% endif %}"
                    >
                        <i class="fa-solid fa-car-tunnel"></i>
                        <span>catalogue vehicules</span>
                    </a>
                </li>

                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}

                    <li>
                        <a
                            href="{{ path('vehicles_models') }}"
                            class="{% if currentRoute == 'vehicles_models' %}is-active{% endif %}"
                        >
                            <i class="fa-solid fa-book"></i>
                            <span>catalogue fabricants</span>
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('vehicle_new') }}" data-ajax-modal>
                            <i class="fa-solid fa-file-circle-plus"></i>
                            <span>creer vehicule</span>
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('vehicle_model_new') }}" data-ajax-modal>
                            <i class="fa-solid fa-file-circle-plus"></i>
                            <span>creer modele</span>
                        </a>
                    </li>

                {% endif %}

            </ul>

        </details>

        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}

            <details class="sidebar-group {% if customersRoutes %}is-active{% endif %}" {% if customersRoutes %}open{% endif %}>

                <summary>
                    <i class="fa-regular fa-address-book"></i>
                    <span>clients</span>
                </summary>

                <ul class="items-list">

                    <li>
                        <a
                            href="{{ path('customer_list') }}"
                            class="{% if currentRoute == 'customer_list' %}is-active{% endif %}"
                        >
                            <i class="fa-regular fa-address-book"></i>
                            <span>liste clients</span>
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('customer_new') }}" data-ajax-modal>
                            <i class="fa-solid fa-user-plus"></i>
                            <span>creer client</span>
                        </a>
                    </li>

                </ul>

            </details>

        {% endif %}

        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}

            <details class="sidebar-group {% if dossiersRoutes %}is-active{% endif %}" {% if dossiersRoutes %}open{% endif %}>

                <summary>
                    <i class="fa-solid fa-folder-open"></i>
                    <span>dossiers</span>
                </summary>

                <ul class="items-list">

                    <li>
                        <a
                            href="{{ path('admin_dossier_list') }}"
                            class="{% if currentRoute == 'admin_dossier_list' %}is-active{% endif %}"
                        >
                            <i class="fa-solid fa-list"></i>
                            <span>liste dossiers</span>
                        </a>
                    </li>

                    <li>
                        <a
                            href="{{ path('admin_dossier_new') }}"
                            class="{% if currentRoute == 'admin_dossier_new' %}is-active{% endif %}"
                        data-ajax-modal>
                            <i class="fa-solid fa-file-circle-plus"></i>
                            <span>Créer un dossier</span>
                        </a>
                    </li>

                </ul>

            </details>

        {% endif %}

    </nav>

</aside>