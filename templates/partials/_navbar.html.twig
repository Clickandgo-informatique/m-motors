<div class="connection">
	{% if app.user %}
		<p class="connected">
			Vous êtes connecté en tant que
			{% if app.user.nickname %}
				<span class="user-nickname">
					<i class="fa-regular fa-circle-user"></i>
					{{ app.user.nickname }}</span>
			{% else %}
				<span class="user-email">
					<i class="fa-regular fa-circle-user"></i>
					{{app.user.email}}</span>
			{% endif %}

		</p>
		<a href="{{ path('app_logout') }}">
			<i class="fa-solid fa-arrow-right-from-bracket"></i>Se déconnecter</a>
	{% else %}
		<p class="not-connected">Vous n'êtes pas encore connecté.e</p>
		<a href="{{ path('app_login') }}">
			<i class="fa-solid fa-right-to-bracket"></i>Se connecter</a>
		<a href="{{ path('app_register') }}">
			<i class="fa-solid fa-user-plus"></i>S'inscrire</a>
	{% endif %}
</div>

<div class="navbar-links">
	<ul>
		<li>
			<a href="{{ path('app_home') }}" class="{{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}">
				Accueil
			</a>
		</li>

		<li>
			<a href="#" class="{{ app.request.attributes.get('_route') == 'app_about' ? 'active' : '' }}">
				À propos
			</a>
		</li>

		<li>
			<a href="#" class="{{ app.request.attributes.get('_route') == 'app_contact' ? 'active' : '' }}">
				Contact
			</a>
		</li>
		{% if app.user %}
			<li>
				<a href="{{path('app_profile')}}" class="{{ app.request.attributes.get('_route') == 'app_profile' ? 'active' : '' }}">
					Mon profil
				</a>
			</li>

		{% endif %}
	</ul>
</div>
