<div class="dropzone-wrapper">
	<div class="dz-counter">0 image</div>

	{# Dropzone #}
	<div class="dropzone" data-upload-url="{{ uploadUrl }}" data-delete-url="{{ deleteUrl }}" data-preview-id="{{ previewId }}" data-destination="{{ destination }}">
		<p>Déposez vos images ou fichiers ici ou cliquez pour sélectionner</p>
		<button type="button" class="dz-upload-btn" disabled>
			Envoyer les fichiers
		</button>
	</div>

	{# Zone de preview #}
	<div id="{{ previewId }}" class="preview-container mb-3"></div>

</div>
