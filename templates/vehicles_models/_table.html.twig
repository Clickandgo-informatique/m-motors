<div class="table-wrapper">
    <table class="table-utac">
        <thead>
            <tr>
                <th></th>
                <th>Id</th>
                <th>Carrosserie</th>
                <th>Marque</th>
                <th>Modèle</th>
                <th>Variante</th>
                <th>CNIT</th>
                <th>CO₂</th>
                <th>Masse min</th>
                <th>Masse max</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
        {% for vmod in vm %}
            <tr id="row-{{ vmod.id }}">

                <td data-label="">
                    <a href="{{ path('vehicle_model_edit', {id: vmod.id}) }}" data-ajax-modal="true">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a>
                </td>

                <td data-label="Id">
                    {{ vmod.id }}
                </td>

                <td data-label="Carrosserie">
                    {{ vmod.bodyType.name }}
                </td>

                <td data-label="Marque">
                    {{ vmod.brand.name }}
                </td>

                <td data-label="Modèle">
                    {{ vmod.variant.model.name ?? '-' }}
                </td>

                <td data-label="Variante">
                    {{ vmod.variant.name ?? '-' }}
                </td>

                <td data-label="CNIT">
                    {{ vmod.cnit }}
                </td>

                <td data-label="CO₂">
                    {{ vmod.co2 }}
                </td>

                <td data-label="Masse min">
                    {{ vmod.massMin }}
                </td>

                <td data-label="Masse max">
                    {{ vmod.massMax }}
                </td>

                <td data-label="">
                    <form method="post"
                          class="form-delete-btn"
                          action="{{ path('vehicle_model_delete', {id: vmod.id}) }}"
                          data-ajax-delete
                          data-delete-target="#row-{{ vmod.id }}">

                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('delete_vehicle_model_' ~ vmod.id) }}">

                        <button class="btn btn-danger btn-sm btn-delete">
                            <i class="fa-regular fa-trash-can"></i>
                        </button>
                    </form>
                </td>

            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>