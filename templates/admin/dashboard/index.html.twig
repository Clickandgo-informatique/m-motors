{% extends 'base.html.twig' %}

{% block title %}
M-motors : Dashboard Admin
{% endblock %}

{% block body %}
<div class="dashboard-wrapper">
	{# KPI GLOBAL #}

	<aside class="kpi-cards-grid mt-4">
	
	<h5 class="text-center mb-3">
		
		<i class="fa-solid fa-chart-line title-icon-sm"></i>
		<span class="text-center">Indicateurs globaux	
		</span>
	</h5>	
	

		<div class="card kpi-card p-3">
			<h6>Total véhicules</h6>

			<span class="text-right">
				<strong>{{ stats.total }}</strong>
			</span>
		</div>

		<div class="card kpi-card p-3">
			<h6>Disponibles</h6>

			<span class="text-right">
				<strong>{{ stats.available }}</strong>
			</span>
		</div>

		<div class="card kpi-card p-3">
			<h6>Loués</h6>
			<span class="text-right">
				<strong>{{ stats.rented }}</strong>
			</span>
		</div>


		<div class="card kpi-card p-3">
			<h6>Maintenance</h6>
			<span class="text-right">
				<strong>{{ stats.maintenance }}</strong>
			</span>
		</div>
		
	</aside>

<section class="dashboard-content">	

	{# RECHERCHE VEHICULE #}
	{# {% include 'Components/Forms/_fetch_form.html.twig' with {
        action: path('admin_dashboard_results'),
        fetchUrl: path('admin_dashboard_results'),
        target: '#vehicles-search-results',
        resultDiv: 'vehicle-autocomplete-results',
        name: 'q',
        placeholder: 'Rechercher un modèle (BMW, Audi...)',
        autocompleteUrl: path('vehicles_ajax_search'),
        baseUrl: path('admin_dashboard'),
        linkMode: 'replace',
        highlight: true,
		fetchMode:'html'
    } %} #}

	{# RESULTATS AJAX (TABLEAU FINAL) #}

	{# <div id="vehicles-search-results"></div> #}
	
	<div class="last-10-dossiers">
	<h1 class="text-center"><i class="fa-solid fa-folder title-icon"></i>Les 10 derniers dossiers</h1>
	{% if dossiers|length >0 %}	
	{% include "dossier/_dossiers_table.html.twig" %}
	{% else %}
		<p class="text-center">
		Il n'existe encore aucun dossier client enregistré
		</p>
	{% endif %}	
	</div>

	</section>
</div>

{% endblock %}
