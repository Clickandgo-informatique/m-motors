{# Données véhicules #}
<div class="card mb-4">

	<div class="card-header">
		<strong>Véhicules</strong>
	</div>

	<div class="card-body">

		{% for vehicle in vehicles %}

			{% set vm = vehicle.vehicleModel %}
			{% set status = vehicle.status %}

			<div class="border rounded p-3 mb-3">

				<h5>
					{{ vm.brand.name ?? '-' }}
					{{ vm.model.name ?? '-' }}
				</h5>

				<div class="row">

					<div class="col-md-3">
						<strong>Statut</strong><br>

						<span class="badge bg-{{ status ? status.badge() : 'secondary' }}">
							{{ status ? status.label() : '-' }}
						</span>
					</div>

					<div class="col-md-3">
						<strong>Prix</strong><br>
						{{ vehicle.price|number_format(0, ',', ' ') }}
						€
					</div>

					<div class="col-md-3">
						<strong>Kilométrage</strong><br>
						{{ vehicle.mileage|number_format(0, ',', ' ') }}
						km
					</div>

					<div class="col-md-3">
						<strong>VIN</strong><br>
						{{ vehicle.vin }}
					</div>

				</div>

				<div class="mt-3">

					<strong>Dossiers</strong>

					<div class="table-responsive mt-2">

						<table class="table align-middle mb-0">

							<thead>
								<tr>
									<th>Client</th>
									<th>Type</th>
									<th>Statut</th>
									<th>Paiement</th>
								</tr>
							</thead>
							<tbody>

								{% for dossier in vehicle.dossiers %}

									<tr>
										<td>
											{{ dossier.customer ? dossier.customer.lastName : '-' }}
										</td>
										<td>
											{{ dossier.type ? dossier.type.label() : '-' }}
										</td>
										<td>
											<span class="badge bg-{{ dossier.status ? dossier.status : 'secondary' }}">
												{{ dossier.status ? dossier.status : '-' }}
											</span>
										</td>
										{# <td>
											{{ dossier.paymentStatus ? dossier.paymentStatus.label() : '-' }}
										</td> #}
									</tr>

								{% else %}

									<tr>
										<td colspan="4">Aucun dossier</td>
									</tr>

								{% endfor %}

							</tbody>

						</table>

					</div>

				</div>

			</div>

		{% else %}

			<p class="text-center">Aucun véhicule trouvé</p>

		{% endfor %}

	</div>

</div>
