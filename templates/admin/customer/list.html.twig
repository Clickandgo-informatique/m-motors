{% extends 'base.html.twig' %}
{% block title %}M-Motors : Liste des clients
{% endblock %}

{% block body %}
	<h1 class="text-center">
		<i class="fa-solid fa-address-book title-icon"></i>Liste des clients</h1>
	<a href="{{ path('customer_new') }}" class="btn btn-primary">
		<i class="fa-solid fa-person-circle-plus"></i>Créer un nouveau client</a>

	<table>
		<thead>
			<tr>
				<th>Code</th>
				<th>Dossiers</th>
				<th>Prénom</th>
				<th>Nom</th>
				<th>Email</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for customer in customers %}
				<tr>
				<td>
					<a href="{{ path('customer_edit', {'id': customer.id}) }}" data-ajax-modal>
					<i class="fa-regular fa-pen-to-square"></i>
					</a>
				</td>
					<td>{{ customer.customerCode }}</td>
					<td>{{ customer.dossiers|length }}</td>
					<td>{{ customer.firstName }}</td>
					<td>{{ customer.lastName }}</td>
					<td>{{ customer.email }}</td>
					<td>						
						<form method="post" class="form-delete-btn" action="{{ path('customer_delete', {'id': customer.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ce client ?');">
							<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ customer.id) }}">
							<button type="submit" class="btn btn-danger btn-delete">
								<i class="fa-regular fa-trash-can"></i>
							</button>
						</form>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
