{% extends 'base.html.twig' %}
{% block title %}Liste des clients
{% endblock %}

{% block body %}
	<h1>Liste des clients</h1>
	<a href="{{ path('customer_new') }}">Créer un nouveau client</a>

	<table>
		<thead>
			<tr>
				<th>ID</th>
				<th>Prénom</th>
				<th>Nom</th>
				<th>Email</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for customer in customers %}
				<tr>
					<td>{{ customer.id }}</td>
					<td>{{ customer.firstName }}</td>
					<td>{{ customer.lastName }}</td>
					<td>{{ customer.email }}</td>
					<td>
						<a href="{{ path('customer_show', {'id': customer.id}) }}">Voir</a>
						|
						<a href="{{ path('customer_edit', {'id': customer.id}) }}">Éditer</a>
						|
						<form method="post" action="{{ path('customer_delete', {'id': customer.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ce client ?');">
							<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ customer.id) }}">
							<button type="submit">Supprimer</button>
						</form>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
