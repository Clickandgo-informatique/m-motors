{% extends 'base.html.twig' %}

{% block title %}Admin - Dossiers
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<h1 class="text-center"><i class="fa-regular fa-folder-open title-icon"></i>Administration des dossiers</h1>

{% include "Components/Forms/_fetch_form.html.twig" %}
		<table class="table table-hover mt-3">

			<thead>
				<tr>
					<th>Référence</th>				
					<th>Véhicule</th>
					<th>Client</th>
					<th>Type</th>
					<th>Statut</th>
					<th>Date</th>
					<th></th>
				</tr>
			</thead>

			<tbody>
				{% for dossier in dossiers %}
					<tr>
						<td>{{ dossier.dossierCode }}</td>
						<td>{{ dossier.vehicle.vehicleModel }}</td>
						<td>{{ dossier.customer }}</td>
						<td>{{ dossier.type.label }}</td>
						<td>
							<span class="badge bg-{{ dossier.statusBadge }}">
								{{ dossier.statusLabel }}
							</span>
						</td>
						<td>{{ dossier.createdAt|date('d/m/Y') }}</td>
						<td>
							<a href="{{ path('admin_dossier_show', {id: dossier.id}) }}" class="btn btn-sm btn-dark">
								Gérer
							</a>
						</td>
					</tr>
				{% endfor %}
			</tbody>

		</table>

	</div>

{% endblock %}
