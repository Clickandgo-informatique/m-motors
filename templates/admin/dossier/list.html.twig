{% extends 'base.html.twig' %}

{% block title %}
	m-motors: admin - dossiers
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<h1 class="text-center">
			<i class="fa-regular fa-folder-open title-icon"></i>
			administration des dossiers
		</h1>

		{% include "Components/Forms/_fetch_form.html.twig" with {
        action: path('admin_dossier_list'),
        fetchUrl: path('dossiers_ajax_search'),
        baseUrl: path('admin_dossier_list'),
        name: 'q',
        hiddenName: '',
        resultDiv: 'autocomplete-results',
        placeholder: 'rechercher un dossier par référence, client, véhicule',
        autocompleteUrl: path('dossiers_ajax_search'),
        target: '#dossiers-search-results',
        fetchMode: 'json',
        filtersTarget: '#dossiers-filters',
        paginationTop: '#dossiers-pagination-top',
        paginationBottom: '#dossiers-pagination-bottom',
        autocomplete: true,
        highlight: true,
        noResultsClass: 'dropdown-no-results',
        linkMode: '1'
    } %}

		{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
			<form action="{{ path('admin_dossier_new') }}" method="post" data-ajax-modal>
				<button type="submit" class="btn btn-primary btn-sm">
					<i class="fa-solid fa-folder-plus"></i>
					créer un dossier
				</button>
			</form>
		{% endif %}

		<div id="dossiers-pagination-top" class="pagination-wrapper">
			{% include "dossier/_pagination_info.html.twig" with { dossiers: dossiers } %}
		</div>

		<div id="dossiers-search-results" class="dossier-search-results">
			{% include "dossier/_dossiers_table.html.twig" with { dossiers: dossiers } %}
		</div>

		<div id="dossiers-pagination-bottom" class="pagination-wrapper">
			{% include "dossier/_pagination_info.html.twig" with { dossiers: dossiers } %}
		</div>

	</div>

{% endblock %}
