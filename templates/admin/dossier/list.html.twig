{% extends 'base.html.twig' %}

{% block title %}Admin - Dossiers{% endblock %}

{% block body %}

	<div class="container mt-4">

		<h1 class="text-center">
			<i class="fa-regular fa-folder-open title-icon"></i>
			Administration des dossiers
		</h1>

		{% include "Components/Forms/_fetch_form.html.twig" with {
			action: path('dossiers_ajax_search'),
			fetchUrl: path('dossiers_ajax_search'),
			autocompleteUrl: path('dossiers_ajax_search'),
			name: 'q',
			placeholder: 'Rechercher un dossier par référence, nom client, modèle de véhicule ...',
			baseUrl: path('admin_dossier_list'),
			linkMode: '1',
			resultDiv: 'autocomplete-results',
			target: 'dossiers-search-results',
			filtersTarget: 'dossiers-filters',
			paginationTarget: 'pagination-wrapper',
			cardsContainer: 'dossiers-search-results',
			autocomplete: true,
			pagination: true,
			highlight: true,
			noResultsClass: 'dropdown-no-results'
		} %}

		{# Pagination haut #}
		<div class="pagination-wrapper" data-target="pagination-top">
			{% include "dossier/_pagination_info.html.twig" with { dossiers: dossiers } %}
		</div>

		<div id="dossiers-search-results" class="dossier-search-results">
			{% include "dossier/_dossiers_table.html.twig" with { dossiers: dossiers } %}
		</div>

		{# Pagination bas #}
		<div class="pagination-wrapper" data-target="pagination-bottom">
			{% include "dossier/_pagination_info.html.twig" with { dossiers: dossiers } %}
		</div>

	</div>

{% endblock %}