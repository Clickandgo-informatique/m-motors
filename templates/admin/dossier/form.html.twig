{{ form_start(form) }}

<div class="form-row">
	{{ form_row(form.financingType) }}
</div>

{% if form.duration is defined %}
	<div class="form-row">{{ form_row(form.duration) }}</div>
{% endif %}

{% if form.annualMileage is defined %}
	<div class="form-row">{{ form_row(form.annualMileage) }}</div>
{% endif %}

{% if form.monthlyPayment is defined %}
	<div class="form-row">{{ form_row(form.monthlyPayment) }}</div>
{% endif %}

<button class="btn btn-primary">Valider</button>

{{ form_end(form) }}
