{% extends 'base.html.twig' %}

{% block title %}Admin - Dossier
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<h1>Gestion du dossier
			{{ dossier.reference }}</h1>

		{# =========================================================
								       STATUT (source : workflowStatus = Symfony Workflow)
								       ========================================================= #}
		<p>
			Statut :
			<span class="badge bg-{{ dossier.statusBadge }}">
				{{ dossier.statusLabel }}
			</span>
		</p>

		<hr>

		{# =========================================================
								       INFOS DOSSIER
								       ========================================================= #}
		<div class="card mb-4">
			<div class="card-body">

				<p>
					<strong>Client :</strong>
					<a href="{{ path('customer_show', {id: dossier.customer.id}) }}">
						[{{ dossier.customer.customerCode }}]
						{{ dossier.customer.lastname }}
						{{ dossier.customer.firstname }}
					</a>
				</p>

				<p>
					<strong>Véhicule :</strong>
					<a href="{{ path('vehicle_edit', {id: dossier.vehicle.id}) }}">
						{{ dossier.vehicle.vehicleModel }}
					</a>
				</p>

				<p>
					<strong>Type :</strong>
					{{ dossier.type.label }}
				</p>

			</div>
		</div>
		{# =========================================================
				   DOCUMENTS DU DOSSIER (DROPZONE)
				   ========================================================= #}

		<div class="card mt-4">
			<div class="card-body">

				<h5>Documents du dossier</h5>

				{% if dossier.workflowStatus in ['draft', 'in_progress'] %}

					<div class="dropzone" data-upload-url="{{ path('dossier_document_upload', { id: dossier.id }) }}" data-delete-url="{{ path('dossier_document_delete', { id: dossier.id }) }}" data-destination="dossier_{{ dossier.id }}/documents" data-preview-id="dossier-documents-preview"></div>

				{% else %}

					<p class="text-muted">
						Les documents ne peuvent plus être modifiés à ce stade du dossier.
					</p>

				{% endif %}

				<hr>

				<div id="dossier-documents-preview" class="d-flex flex-wrap gap-2 mt-3">

					{% for doc in dossier.documents %}
						<div class="dz-thumb" data-file="{{ doc.filename }}">
							<img src="/uploads/{{ doc.path }}" width="120" class="rounded border">
							<button class="dz-delete" data-file="{{ doc.filename }}">×</button>
						</div>
					{% else %}
						<p class="text-muted">Aucun document uploadé</p>
					{% endfor %}

				</div>

			</div>
		</div>
		{# =========================================================
								       WORKFLOW ACTIONS
								       ========================================================= #}
		<div class="card">
			<div class="card-body">

				<h5>Actions workflow</h5>

				<div
					class="d-flex gap-2 flex-wrap">

					{# -------------------------
																				                   START
																				                   draft → in_progress
																				                   ------------------------- #}
					{% if workflow_can(dossier, 'start') %}
						<form method="post" action="{{ path('dossier_transition', { id: dossier.id, transition: 'start' }) }}">

							<input type="hidden" name="_token" value="{{ csrf_token('workflow_transition_' ~ dossier.id) }}">

							<button type="submit" class="btn btn-primary">
								Démarrer
							</button>
						</form>
					{% endif %}

					{# -------------------------
																				                   COMPLETE
																				                   in_progress → completed
																				                   ------------------------- #}
					{% if workflow_can(dossier, 'complete') %}
						<form method="post" action="{{ path('dossier_transition', { id: dossier.id, transition: 'complete' }) }}">

							<input type="hidden" name="_token" value="{{ csrf_token('workflow_transition_' ~ dossier.id) }}">

							<button type="submit" class="btn btn-success">
								Terminer
							</button>
						</form>
					{% endif %}

					{# -------------------------
																				                   CANCEL (2 transitions possibles)
																				                   ------------------------- #}
					{% if workflow_can(dossier, 'cancel_from_draft') %}

						<form method="post" action="{{ path('dossier_transition', { id: dossier.id, transition: 'cancel_from_draft' }) }}" onsubmit="return confirm('Confirmer l’annulation ?');">

							<input type="hidden" name="_token" value="{{ csrf_token('workflow_transition_' ~ dossier.id) }}">

							<button type="submit" class="btn btn-danger">
								Annuler
							</button>
						</form>

					{% elseif workflow_can(dossier, 'cancel_from_progress') %}

						<form method="post" action="{{ path('dossier_transition', { id: dossier.id, transition: 'cancel_from_progress' }) }}" onsubmit="return confirm('Confirmer l’annulation ?');">

							<input type="hidden" name="_token" value="{{ csrf_token('workflow_transition_' ~ dossier.id) }}">

							<button type="submit" class="btn btn-danger">
								Annuler
							</button>
						</form>

					{% endif %}

				</div>

			</div>
		</div>

	</div>
	<form id="upload-form" enctype="multipart/form-data">
		<input type="file" name="file" id="file-input">
		<button type="submit">Uploader</button>
	</form>

	<script>
		document.getElementById('upload-form').addEventListener('submit', async (e) => {
e.preventDefault();

const file = document.getElementById('file-input').files[0];
const formData = new FormData();
formData.append('file', file);

const res = await fetch('{{ path('dossier_document_upload', {id: dossier.id}) }}', {
method: 'POST',
body: formData
});

console.log(await res.json());
});
	</script>
{% endblock %}
