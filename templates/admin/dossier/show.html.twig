{% extends 'base.html.twig' %}

{% block title %}
M-Motors: Dossier {{ dossier.dossierCode }}
{% endblock %}

{% block body %}

<a href="{{ path('admin_dossier_list') }}" class="btn">
    <i class="fa-solid fa-list"></i> Revenir à la liste de dossiers
</a>

<div class="dossier-grid">

    <div class="dossier-left">

        {% include "dossier/_progress_timeline.html.twig" %}

        {% include 'dossier/_workflow_logs.html.twig' with {
            workflowLogs: workflowLogs ?? []
        } %}

    </div>

    <div class="dossier-right">

        <div class="card">
            <div class="card-body">

                <h1>
                    <i class="fa-solid fa-folder-open"></i>
                    Dossier {{ dossier.dossierCode }}
                </h1>

                <p>
                    Statut :
                    <span class="badge bg-{{ dossier.statusBadge }}">
                        {{ dossier.statusLabel }}
                    </span>

                    <span class="text-muted">
                        Créé le {{ dossier.createdAt|format_datetime(locale='fr', pattern="d MMMM yyyy à HH:mm") }}
                    </span>
                </p>

            </div>

            <a href="{{ path('admin_dossier_edit', {id: dossier.id}) }}" class="btn">
                <i class="fa-solid fa-pen-to-square"></i> Éditer ce dossier
            </a>
        </div>

        <div class="card">
            <div class="card-body">

                <h5>Étape 1 : Informations dossier</h5>

                <p>
                    <strong>Client :</strong>
                    {% if dossier.customer %}
                        <a href="{{ path('customer_edit', {id: dossier.customer.id}) }}" data-ajax-modal>
                            {{ dossier.customer.lastName }} {{ dossier.customer.firstName }}
                        </a>
                    {% else %}
                        —
                    {% endif %}
                </p>

                <p>
                    <strong>Véhicule :</strong>
                    {% if dossier.vehicle and dossier.vehicle.vehicleModel %}
                        {{ dossier.vehicle.vehicleModel.brand.name }} {{ dossier.vehicle.vehicleModel.model.name }}
                    {% else %}
                        —
                    {% endif %}
                </p>

                <p>
                    <strong>Type :</strong>
                    {{ dossier.type.label }}
                </p>

            </div>
        </div>

        <div class="card">
            <div class="card-body">

                <h5>Étape 2 : Documents</h5>

                {% if dossier.status in ['draft', 'in_progress'] %}

                    <div class="dropzone"
                         data-upload-url="{{ path('dossier_document_upload', {id: dossier.id}) }}"
                         data-delete-url="{{ path('dossier_document_delete', {id: '__id__'}) }}"
                         data-documents-url="{{ path('dossier_documents_list', {id: dossier.id}) }}"
                         data-preview-id="dossier-documents-preview"
                         data-locked="{{ dossier.status not in ['draft', 'in_progress'] ? 1 : 0 }}"
                         data-mode="workflow">

                        <p class="text-muted">
                            Glissez vos fichiers ici ou cliquez pour ajouter
                        </p>

                    </div>

                    {% if dossier.status == 'draft' %}
                        <button class="btn btn-primary mt-2 dz-upload-btn" disabled>
                            Soumettre les documents
                        </button>
                    {% endif %}

                    <div id="dossier-documents-preview" class="preview-container">

                        {% for doc in dossier.documents %}

                            {% set ext = doc.fileName|split('.')|last|lower %}

                            <div class="dz-thumb" data-id="{{ doc.id }}">

                                <div class="dz-preview">

                                    {% if ext in ['jpg','jpeg','png','webp'] %}
                                        <img src="{{ asset('uploads/' ~ doc.path) }}">

                                    {% elseif ext == 'pdf' %}
                                        <div>PDF</div>

                                    {% elseif ext in ['doc','docx'] %}
                                        <div>WORD</div>

                                    {% elseif ext in ['xls','xlsx'] %}
                                        <div>EXCEL</div>

                                    {% else %}
                                        <div>Fichier</div>
                                    {% endif %}

                                </div>

                                <div>{{ doc.originalName }}</div>
                                <div>{{ doc.createdAt|date('d/m/Y H:i') }}</div>

                                {% if dossier.status in ['draft', 'in_progress'] %}
                                    <button class="dz-delete" data-id="{{ doc.id }}">×</button>
                                {% endif %}

                            </div>

                        {% else %}
                            <p>Aucun document</p>
                        {% endfor %}

                    </div>

                {% else %}
                    <p>Documents verrouillés</p>
                {% endif %}

            </div>
        </div>

        {% if is_granted('ROLE_MANAGER') or is_granted('ROLE_ADMIN') %}

            {% if dossier.status == 'in_progress' %}

                <div class="card">
                    <div class="card-body">

                        <h5>Étape 3 : Actions manager</h5>

                        <a href="{{ path('dossier_validate', {id: dossier.id}) }}">
                            Valider
                        </a>

                        <a href="{{ path('dossier_reject', {id: dossier.id}) }}">
                            Refuser
                        </a>

                    </div>
                </div>

            {% endif %}

        {% endif %}

        {% if dossier.status in ['validated', 'rejected'] %}

            <div>
                Dossier terminé : {{ dossier.statusLabel }}
            </div>

            {% if dossier.vehicle %}

                <div class="card">
                    <div class="card-body">

                        <h5>Impact véhicule</h5>

                        <p>
                            Statut :
                            {% if dossier.vehicle.status is defined and dossier.vehicle.status %}
                                <span class="badge bg-{{ dossier.vehicle.status.badge }}">
                                    {{ dossier.vehicle.status.label }}
                                </span>
                            {% else %}
                                —
                            {% endif %}
                        </p>

                    </div>
                </div>

            {% endif %}

        {% endif %}

    </div>

</div>

{% endblock %}