{% extends 'base.html.twig' %}

{% block title %}M-Motors: Admin - Dossier
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<h1 class="text-center">
			<i class="fa-solid fa-folder-open title-icon"></i>
			Dossier
			{{ dossier.dossierCode }}
		</h1>

		<p>
			Statut :
			<span class="badge bg-{{ dossier.statusBadge }}">
				{{ dossier.statusLabel }}
			</span>
			<span class=text-muted">Créé le
				{{dossier.createdAt|format_datetime(locale='fr', pattern="d MMMM yyyy à H:mm:s")}}</span>
		</p>

		<hr>

		{# ========================= INFO ========================= #}
		<div class="card mb-4">
			<div class="card-body">
				<p>
					<strong>Client :</strong>
					{{ dossier.customer.lastname }}
				</p>
				<p>
					<strong>Véhicule :</strong>
					{{ dossier.vehicle.vehicleModel }}
				</p>
			</div>
		</div>

		{# ========================= DROPZONE ========================= #}
		<div class="card">
			<div class="card-body">

				<h5>Documents</h5>

				{% if dossier.status in ['draft', 'in_progress'] %}

					<div class="dropzone" data-upload-url="{{ path('dossier_document_upload', {id: dossier.id}) }}" data-delete-url="{{ path('dossier_document_delete', {id: '__id__'}) }}" data-documents-url="{{ path('dossier_documents_list', {id: dossier.id}) }}" data-preview-id="dossier-documents-preview" data-locked="{{ dossier.status == 'validated' ? 1 : 0 }}">

						<p class="text-muted">
							Glissez vos fichiers ou cliquez ici
						</p>

					</div>

					<button type="button" class="btn btn-primary mt-2 dz-upload-btn" disabled>
						Envoyer les fichiers
					</button>

				{% else %}
					<p class="text-muted">Modification désactivée</p>
				{% endif %}

				{# ========================= PREVIEW ========================= #}
				<div id="dossier-documents-preview" class="preview-container mt-3">

					{% for doc in dossier.documents %}

						{% set ext = doc.fileName|split('.')|last|lower %}

						<div
							class="dz-thumb" data-id="{{ doc.id }}">

							{# ===== PREVIEW ===== #}
							<div class="dz-preview">
								{% if ext in ['jpg','jpeg','png','webp'] %}
									<img src="{{ asset('uploads/' ~ doc.path) }}">
								{% elseif ext == 'pdf' %}
									<div class="dz-file-preview dz-pdf">PDF</div>
								{% elseif ext in ['doc','docx'] %}
									<div class="dz-file-preview dz-word">WORD</div>
								{% elseif ext in ['xls','xlsx'] %}
									<div class="dz-file-preview dz-excel">EXCEL</div>
								{% else %}
									<div class="dz-file-preview dz-generic">Fichier</div>
								{% endif %}
							</div>

							{# ===== NOM ===== #}
							<div class="dz-filename">
								{{ doc.originalName }}
							</div>

							{# ===== DATE ===== #}
							<div class="dz-meta">
								Envoyé le
								{{ doc.createdAt ? doc.createdAt|date('d/m/Y H:i') : '' }}
							</div>

							{# ===== STATUS ===== #}
							{# <div class="mt-2">
								<span class="badge bg-{{ doc.status.badge }} text-center">
									{{ doc.status.label }}
								</span>
							</div> #}

							{# ===== ACTIONS ADMIN ===== #}
							{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}

								{% if doc.status.value == 'uploaded' %}

									<div class="mt-2 d-flex gap-1">

										<button class="btn btn-success btn-sm js-validate" data-id="{{ doc.id }}">
											✔
										</button>

										<button class="btn btn-danger btn-sm js-reject" data-id="{{ doc.id }}">
											✖
										</button>

									</div>

								{% endif %}

							{% endif %}

							{# ===== DELETE USER ===== #}
							{% if dossier.status in ['draft', 'in_progress'] %}
								<button class="dz-delete" data-id="{{ doc.id }}">×</button>
							{% endif %}

						</div>

					{% else %}
						<p class="text-muted">Aucun document</p>
					{% endfor %}

				</div>

			</div>
		</div>

	</div>

{% endblock %}
