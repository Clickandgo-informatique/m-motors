{% extends 'base.html.twig' %}

{% block title %}Admin - Dossier
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<h1>Gestion du dossier
			{{ dossier.reference }}</h1>

		<p>
			Statut :
			<span class="badge bg-{{ dossier.status.badge }}">
				{{ dossier.status.label }}
			</span>
		</p>

		<hr>

		<div class="card mb-4">
			<div class="card-body">

				<p>
					<strong>Client :</strong>
					{{ dossier.customer }}</p>
				<p>
					<strong>Véhicule :</strong>
					{{ dossier.vehicle }}</p>
				<p>
					<strong>Type :</strong>
					{{ dossier.type }}</p>

			</div>
		</div>

		<div class="card">
			<div class="card-body">

				<h5>Actions workflow</h5>

				<div class="d-flex gap-2 flex-wrap">

					{% if workflow.can(dossier, 'start') %}
						<form method="post" action="{{ path('dossier_transition', { id: dossier.id, transition: 'start' }) }}">
							<button class="btn btn-primary">
								Démarrer
							</button>
						</form>
					{% endif %}

					{% if workflow.can(dossier, 'complete') %}
						<form method="post" action="{{ path('dossier_transition', { id: dossier.id, transition: 'complete' }) }}">
							<button class="btn btn-success">
								Terminer
							</button>
						</form>
					{% endif %}

					{% if workflow.can(dossier, 'cancel') %}
						<form method="post" action="{{ path('dossier_transition', { id: dossier.id, transition: 'cancel' }) }}" onsubmit="return confirm('Confirmer ?');">

							<button class="btn btn-danger">
								Annuler
							</button>

						</form>
					{% endif %}

				</div>

			</div>
		</div>

	</div>

{% endblock %}
