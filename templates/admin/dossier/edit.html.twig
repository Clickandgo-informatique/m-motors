{# templates/admin/dossier/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}M-Motors :
	{{title}}
{% endblock %}

{% block body %}
	<h1>{{title}}
	</h1>

	{# Messages flash #}
	{% for message in app.flashes('success') %}
		<div class="alert alert-success">{{ message }}</div>
	{% endfor %}
	{% for message in app.flashes('error') %}
		<div class="alert alert-danger">{{ message }}</div>
	{% endfor %}

	{# Formulaire Symfony #}
	{{ form_start(form) }}
	<div class="mb-3">
		{{ form_label(form.vehicle) }}
		{{ form_widget(form.vehicle, {'attr': {'class': 'form-control'}}) }}
		{{ form_errors(form.vehicle) }}
	</div>

	<div class="mb-3">
		{{ form_label(form.type) }}
		{{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
		{{ form_errors(form.type) }}
	</div>

	<div class="mb-3">
		{{ form_label(form.status) }}
		{{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
		{{ form_errors(form.status) }}
	</div>

	<div class="mb-3">
		{{ form_label(form.documents) }}
		{{ form_widget(form.documents, {'attr': {'class': 'form-control'}}) }}
		{{ form_errors(form.documents) }}
	</div>

	<button class="btn btn-primary">Enregistrer</button>
	{{ form_end(form) }}

	<a href="{{ path('dossier_list') }}" class="btn btn-secondary mt-3">Retour à la liste des dossiers</a>
{% endblock %}
