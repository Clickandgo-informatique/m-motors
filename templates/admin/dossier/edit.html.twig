{% extends 'base.html.twig' %}

{% block title %}M-Motors :
	{{ title }}
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<h1>{{ title }}</h1>

		<div class="card">
			<div class="card-body">

				<div class="alert alert-info">
					Étape 1 : Création du dossier
				</div>

				{{ form_start(form) }}

				<div class="mb-3">
					{{ form_label(form.customer) }}
					{{ form_widget(form.customer, {'attr': {'class': 'form-control'}}) }}
					{{ form_errors(form.customer) }}
				</div>

				<div class="mb-3">
					{{ form_label(form.vehicle) }}
					{{ form_widget(form.vehicle, {'attr': {'class': 'form-control'}}) }}
					{{ form_errors(form.vehicle) }}
				</div>

				<div class="mb-3">
					{{ form_label(form.type) }}
					{{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
					{{ form_errors(form.type) }}
				</div>

				<div class="mb-3">
					{{ form_label(form.financingType) }}
					{{ form_widget(form.financingType, {'attr': {'class': 'form-control'}}) }}
					{{ form_errors(form.financingType) }}
				</div>

				<button class="btn btn-primary">
					Créer le dossier
				</button>

				{{ form_end(form) }}

			</div>
		</div>

		<a href="{{ path('dossier_list') }}" class="btn btn-secondary mt-3">
			Retour
		</a>

	</div>

{% endblock %}
