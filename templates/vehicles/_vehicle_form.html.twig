{% extends "base.html.twig" %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}

	<h1 class="text-center">
		<i class="fa-solid fa-circle-plus"></i>
		{{ title }}
	</h1>

	{{ form_start(form, {
    attr: {
        'data-search-form': path('vehicle_model_search'),
        'data-query-param': 'q',
        'data-dropdown-class': 'dropdown-results',
        'data-item-class': 'dropdown-item',
        'data-link-class': 'dropdown-link',
        'data-no-results-class': 'dropdown-no-results',
        'data-item-url': '/vehicles/models/__ID__/edit',
        'data-ajax-form': 'true'
    }
}) }}

	{# Modèle véhicule #}
	{% if vehicle.vehicleModel and vehicle.vehicleModel.brand and vehicle.vehicleModel.model %}
		<h4 class="text-center">
			<strong>{{ vehicle.vehicleModel.brand.name }}</strong>
			{{ vehicle.vehicleModel.model.name }}
		</h4>
	{% endif %}

	{# STATUS / SUPPLIER #}
	<div class="form-row">

		<div class="form-group">
			{{ form_label(form.status) }}
			{{ form_widget(form.status) }}
			{{ form_errors(form.status) }}
		</div>

		<div class="form-group">
			{{ form_label(form.supplier) }}
			{{ form_widget(form.supplier) }}
			{{ form_errors(form.supplier) }}
		</div>

	</div>

	{# AUTOCOMPLETE MODEL #}
	<div class="form-row">

		<div class="form-group autocomplete-container">

			{{ form_label(form.vehicleModelSearch) }}

			<div class="dropdown-wrapper">

				{{ form_widget(form.vehicleModelSearch, {
                attr: {
                    autocomplete: 'off',
                    'data-autocomplete': 'true',
                    'data-result-div': '#vehicle-model-results',
                    'data-hidden-target': '#vehicle_vehicleModel'
                }
            }) }}

				{{ form_widget(form.vehicleModel, {
                attr: { style: 'display:none;' }
            }) }}

				<div id="vehicle-model-results" class="dropdown-results"></div>

			</div>

			{{ form_errors(form.vehicleModelSearch) }}

		</div>

		<div class="form-actions">
			<a href="javascript:void(0)">
				<i class="fa-regular fa-folder-open"></i>
			</a>

			<a href="{{ path('vehicle_model_new') }}">
				<i class="fa-solid fa-circle-plus"></i>
			</a>
		</div>

	</div>

	{# IDENTIFIERS #}
	<div class="form-row">

		<div class="form-group">
			{{ form_label(form.vin) }}
			{{ form_widget(form.vin) }}
			{{ form_errors(form.vin) }}
		</div>

		<div class="form-group">
			{{ form_label(form.registrationNumber) }}
			{{ form_widget(form.registrationNumber) }}
			{{ form_errors(form.registrationNumber) }}
		</div>

	</div>

	{# MAIN INFOS #}
	<div class="form-row">

		<div class="form-group">
			{{ form_label(form.mileage) }}
			{{ form_widget(form.mileage) }}
			{{ form_errors(form.mileage) }}
		</div>

		<div class="form-group">
			{{ form_label(form.firstRegistrationDate) }}
			{{ form_widget(form.firstRegistrationDate) }}
			{{ form_errors(form.firstRegistrationDate) }}
		</div>

		<div class="form-group">
			{{ form_label(form.price) }}

			<div class="input-group">
				{{ form_widget(form.price) }}				
			</div>

			{{ form_errors(form.price) }}
		</div>

	</div>

	{# TECH INFOS #}
	<div class="form-row">

		<div class="form-group">
			{{ form_label(form.color) }}
			{{ form_widget(form.color) }}
			{{ form_errors(form.color) }}
		</div>

		<div class="form-group">
			{{ form_label(form.fuelType) }}
			{{ form_widget(form.fuelType) }}
			{{ form_errors(form.fuelType) }}
		</div>

		<div class="form-group">
			{{ form_label(form.gearType) }}
			{{ form_widget(form.gearType) }}
			{{ form_errors(form.gearType) }}
		</div>

	</div>

	{# FEATURES #}
	<div class="form-row">

		<div class="vehicle-features-list">

			{% if vehicle.features|length > 0 %}

				{% for feature in vehicle.features|sort((a, b) => a.label <=> b.label) %}
					{{ feature.label }}
					{% if not loop.last %},
					{% endif %}
				{% endfor %}

			{% else %}
				<p class="alert alert-warning text-center">
					Aucune option enregistrée
				</p>
			{% endif %}

		</div>

		<div class="form-actions">
			<a href="javascript:void(0)">
				<i class="fa-solid fa-circle-plus"></i>
			</a>
		</div>

	</div>

	{# DROPZONE #}
	{% set isNew = vehicle.id is null %}

	{% include 'partials/_dropzone.html.twig' with {
    uploadUrl: path('vehicle_image_upload'),
    deleteUrl: path('vehicle_image_delete', { id: '__id__' }),
    documentsUrl: isNew ? '' : path('vehicle_images', { id: vehicle.id }),
    previewId: 'vehicle-gallery-preview',
    destination: vehicle.id ?? '',
    status: vehicle.status.value ?? 'draft',
    locked: isNew
} %}

	{{ form_end(form) }}

{% endblock %}
