{% extends 'base.html.twig' %}

{% block title %}
    m-motors : catalogue véhicules
{% endblock %}

{% block body %}

    <div class="vehicles-layout">
        {# filtres #}
        <aside
            class="vehicles-filters"
            id="filters-drawer">

            <div class="filters-drawer-header"> 

                <div class="filters-drawer-count"> 
                <span id="vehicles-results-count">
                    {{ vehicles|length }}
                </span>
                <span>résultats</span>
             </div>            

                <button
                    type="button"
                    id="filters-drawer-close"
                    class="filters-drawer-close"
                    aria-label="Fermer les filtres"
                >
                    <i class="fa-solid fa-xmark"></i>
                </button>

            </div>

            <div class="filters-drawer-body">

                {{ render(controller(
                    'App\\Controller\\VehiclesFilterController::sidebarFilters'
                )) }}
            </div>
        </aside>
        <div
            class="filters-backdrop"
            id="filters-backdrop">
        </div>

        <button
            class="filters-fab"
            id="filters-fab"
            aria-label="Ouvrir les filtres">
            <i class="fa-solid fa-sliders"></i>
        </button>

        {# contenu principal #}
        <main class="vehicles-main">

            <h1 class="text-center">
                <i class="fa-solid fa-car-side title-icon"></i>
                Catalogue véhicules
            </h1>

            {# badges filtres actifs #}
            <div class="vehicles-active-filters">
                <div id="filters-summary"></div>
            </div>
            
            {# view switcher #}

            {#
            <form
                id="view-switcher-form"
                class="fetch-form"
                data-module="fetch-form"
                data-fetch-url="{{ path('vehicles_ajax_list') }}"
                data-fetch-mode="json"
                data-target="#vehicles-results"
                data-filters-target=".vehicles-filters"
                data-pagination-top="#vehicles-pagination-top"
                data-pagination-bottom="#vehicles-pagination-bottom"
            >

                <div id="view-toggle">

                    <input
                        type="radio"
                        name="filters[view]"
                        value="grid"
                        checked
                    >

                    <input
                        type="radio"
                        name="filters[view]"
                        value="table"
                    >

                    <label>
                        <span class="icon-grid"></span>
                    </label>

                    <label>
                        <span class="icon-table"></span>
                    </label>

                    <div class="toggle-thumb"></div>

                </div>

                <input
                    type="hidden"
                    name="page"
                    value="1"
                >

            </form>
            #}

            {# recherche autocomplete #}

            {% include 'Components/Forms/_fetch_form.html.twig' with {
                action: path('vehicles_index'),
                fetchUrl: path('vehicles_ajax_list'),
                target: '#vehicles-results',
                filtersTarget: '.vehicles-filters',
                paginationTop: '#vehicles-pagination-top',
                paginationBottom: '#vehicles-pagination-bottom',
                autocompleteUrl: path('vehicles_ajax_search'),
                resultDiv: 'autocomplete-results',
                name: 'q',
                placeholder: 'Rechercher un véhicule',
                linkMode: '1',
                fetchMode: 'json',
                editRouteTemplate: path('vehicle_edit', { id: 0 }),
                baseUrl: '/vehicles/'
            } %}

            {# pagination top #}
            <div id="vehicles-pagination-top">

                {% include 'vehicles/_pagination.html.twig' with {
                    vehicles: vehicles
                } %}

            </div>

            {# résultats #}
            <div id="vehicles-results">
                {% include 'vehicles/_vehicles_list.html.twig' %}
            </div>

            {# pagination bottom #}
            <div id="vehicles-pagination-bottom">

                {% include 'vehicles/_pagination.html.twig' with {
                    vehicles: vehicles
                } %}
            </div>
        </main>
    </div>

{% endblock %}