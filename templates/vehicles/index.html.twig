{% extends 'base.html.twig' %}

{% block title %}M-motors : Catalogue véhicules
{% endblock %}

{% block body %}

	<div
		class="vehicles-page">

		{# FORM GLOBAL UNIQUE (SOURCE DE VERITE) #}
		<form method="get" action="{{ path('vehicles_index') }}" data-module="fetch-form" data-fetch-url="{{ path('vehicles_ajax_list') }}" data-target="#vehicles-results" data-fetch-mode="json" data-filters-target="#filters-summary" data-pagination-top="#vehicles-pagination-top" data-pagination-bottom="#vehicles-pagination-bottom" class="fetch-form vehicles-fetch-form">

			<div
				class="vehicles-layout">

				{# SIDEBAR = DANS LE FORM (OBLIGATOIRE) #}
				<aside id="filters-drawer" class="vehicles-filters vehicles-filters--catalog">

					<div class="filters-drawer-header">
						<button type="button" id="filters-drawer-close" class="filters-drawer-close">
							<i class="fa-solid fa-xmark"></i>
						</button>
					</div>

					<div class="vehicles-filters-content">
						{{ render(controller('App\\Controller\\VehiclesFilterController::sidebarFilters')) }}
					</div>

				</aside>

				<main class="vehicles-main vehicles-main--catalog">

					<h1 class="text-center">
						<i class="fa-solid fa-car-side"></i>
						Catalogue véhicules
					</h1>


					{# SEARCH COMPONENT (inputs inclus dans le form) #}
					{% include 'Components/Forms/_fetch_form.html.twig' with {
                    action: path('vehicles_index'),
                    baseUrl: path('vehicles_index'),
                    fetchUrl: path('vehicles_ajax_list'),
                    target: '#vehicles-results',
                    filtersTarget: '#filters-summary',
                    paginationTop: '#vehicles-pagination-top',
                    paginationBottom: '#vehicles-pagination-bottom',
                    autocompleteUrl: path('vehicles_ajax_search'),
                    resultDiv: 'autocomplete-results',
                    name: 'q',
                    placeholder: 'Rechercher un véhicule par marque ou modèle ...',
                    linkMode: '1',
                    fetchMode: 'json',
                    ajaxModal: true,
                    autocomplete: true
                } %}

					{# BADGES #}
					<div id="filters-summary"></div>

					{# PAGINATION TOP #}
					<div id="vehicles-pagination-top">
						{% include "vehicles/_pagination_info.html.twig" with { vehicles: vehicles } %}
					</div>

					{# Résultats recherche véhicules #}
					<div id="vehicles-results" class="vehicles-grid">
						{% include 'vehicles/_vehicles_gallery_items.html.twig' %}
					</div>

					{# PAGINATION BOTTOM #}
					<div id="vehicles-pagination-bottom">
						{% include "vehicles/_pagination_info.html.twig" with { vehicles: vehicles } %}
					</div>

				</main>

			</div>

		</form>

	</div>

	<div class="filters-backdrop" id="filters-backdrop"></div>

	<button class="filters-fab" id="filters-fab">
		<i class="fa-solid fa-sliders"></i>
	</button>

{% endblock %}
