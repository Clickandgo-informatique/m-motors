{% extends 'base.html.twig' %}

{% block title %}M-motors : Catalogue véhicules{% endblock %}

{% block body %}

<div class="vehicles-page">

    <div class="vehicles-layout">

        <aside class="vehicles-filters" id="filters-drawer">

            <div class="filters-drawer-header">
                <button
                    type="button"
                    id="filters-drawer-close"
                    class="filters-drawer-close"
                    aria-label="fermer"
                >
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="vehicles-filters-content">
                {{ render(controller('App\\Controller\\VehiclesFilterController::sidebarFilters')) }}
            </div>

        </aside>

        <main class="vehicles-main">

            <h1 class="text-center">
                <i class="fa-solid fa-car-side"></i>
                catalogue véhicules
            </h1>

            <div class="vehicles-active-filters">
                <div id="filters-summary"></div>
            </div>

            {% include 'Components/Forms/_fetch_form.html.twig' with {
                action: path('vehicles_index'),
                fetchUrl: path('vehicles_ajax_list'),
                target: '#vehicles-results',
                filtersTarget: '.vehicles-filters',
                paginationTop: '#vehicles-pagination-top',
                paginationBottom: '#vehicles-pagination-bottom',
                autocompleteUrl: path('vehicles_ajax_search'),
                resultDiv: 'autocomplete-results',
                name: 'q',
                placeholder: 'rechercher un véhicule',
                linkMode: '1',
                fetchMode: 'json',
                editRouteTemplate: path('vehicle_edit', { id: 0 }),
                baseUrl: '/vehicles/'
            } %}

            <div id="vehicles-pagination-top"></div>

            <div id="vehicles-results">
                {% include 'vehicles/_vehicles_list.html.twig' %}
            </div>

            <div id="vehicles-pagination-bottom"></div>

        </main>

    </div>

</div>

<div class="filters-backdrop" id="filters-backdrop"></div>

<button class="filters-fab" id="filters-fab">
    <i class="fa-solid fa-sliders"></i>
</button>
{% endblock %}