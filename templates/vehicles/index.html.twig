{% extends "base.html.twig" %}

{% block body %}
	<h1 class="text-center">Catalogue véhicules</h1>

	<div class="layout">

		<main>

			{# Toggle view #}
			<form id="view-switch-form" data-fetch-form data-fetch-url="{{ path('vehicles_ajax_list') }}" data-target="#vehicles-results">

				<div id="view-toggle">
					<input type="radio" name="filters[view]" value="grid" checked>
					<input type="radio" name="filters[view]" value="table">
				</div>
			</form>

			{# SEARCH #}
			{% include "Components/Forms/_fetch_form.html.twig" with {
            action: path('vehicles_ajax_search'),
            name: 'q',
            resultDiv: 'autocomplete-results'
        } %}

			{# RESULTS #}
			<div id="vehicles-results">
				{% include 'vehicles/_vehicles_list.html.twig' %}
			</div>

		</main>

	</div>
{% endblock %}
