{% extends "base.html.twig" %}

{% block title %}M-Motors : Liste des véhicules enregistrés
{% endblock %}

{% block body %}
	<h1 class="text-center">Liste des véhicules enregistrés</h1>

	{# Conteneur principal pour AJAX (résultats + pagination) #}
	<div id="vehicles-results" data-fetch-form data-fetch-url="{{ path('vehicles_search') }}">

		{% if vehicles is not empty %}

			{# Résumé / badges des filtres (géré par JS) #}
			<div id="filters-summary" data-target="filters-summary"></div>

			{# Pagination en haut #}
			<div class="pagination-wrapper" data-target="pagination-top">
				{% include "vehicles/_pagination_info.html.twig" with {vehicles: vehicles} %}
			</div>

			<table>
				<thead>
					<tr>
						<th>Etat</th>
						<th>Immatriculation</th>
						<th>Marque</th>
						<th>Modèle</th>
						<th>Kilométrage</th>
						<th>Carrosserie</th>
						<th>Carburant</th>
						<th>Prix</th>
					</tr>
				</thead>
				<tbody id="vehicles-search-results" data-target="vehicles-search-results">
					{% include "vehicles/_vehicles_search_results.html.twig" with {vehicles: vehicles} %}
				</tbody>
			</table>

			{# Pagination en bas #}
			<div class="pagination-wrapper" data-target="pagination-bottom">
				{% include "vehicles/_pagination_info.html.twig" with {vehicles: vehicles} %}
			</div>

		{% else %}
			<p class="alert">Il n'existe encore aucun véhicule dans la base.</p>
		{% endif %}

	</div>
{% endblock %}
