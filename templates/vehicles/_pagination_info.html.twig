{% if vehicles is defined and vehicles|length != 0 %}
	<div class="pagination-info-text text-center">
		{{ vehicles.totalItemCount }}
		véhicule{{ vehicles.totalItemCount > 1 ? 's' : '' }}
		-
				    Page
		{{ vehicles.currentPageNumber }}/{{ vehicles.pageCount }}
	</div>

	<div class="pagination">
		{% if vehicles.currentPageNumber > 1 %}
			<a href="#" class="first-page" data-page="1">« Première</a>
			<a href="#" class="prev-page" data-page="{{ vehicles.currentPageNumber - 1 }}">← Précédent</a>
		{% endif %}

		{% set start = vehicles.currentPageNumber - 2 %}
		{% set end = vehicles.currentPageNumber + 2 %}
		{% if start < 1 %}
			{% set start = 1 %}
		{% endif %}
		{% if end > vehicles.pageCount %}
			{% set end = vehicles.pageCount %}
		{% endif %}

		{% if start > 1 %}
			<span class="dots">...</span>
		{% endif %}

		{% for i in start..end %}
			<a href="#" class="{{ i == vehicles.currentPageNumber ? 'active' : '' }}" data-page="{{ i }}">{{ i }}</a>
		{% endfor %}

		{% if end < vehicles.pageCount %}
			<span class="dots">...</span>
		{% endif %}

		{% if vehicles.currentPageNumber < vehicles.pageCount %}
			<a href="#" class="next-page" data-page="{{ vehicles.currentPageNumber + 1 }}">Suivant →</a>
			<a href="#" class="last-page" data-page="{{ vehicles.pageCount }}">Dernière »</a>
		{% endif %}
	</div>
{% else %}
	<div class="pagination-wrapper disabled">Aucun véhicule trouvé</div>
{% endif %}
