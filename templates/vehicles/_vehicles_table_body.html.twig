{# templates/vehicles/_vehicles_table.html.twig #}
<table class="table table-striped">
	<thead>
		<tr>
			<th>Statut</th>
			<th>Immatriculation</th>
			<th>Marque</th>
			<th>Modèle</th>
			<th>Kilométrage</th>
			<th>Carrosserie</th>
			<th>Énergie</th>
			<th>Prix</th>
		</tr>
	</thead>
	<tbody>
		{% for vehicle in vehicles %}
			<tr>
				<td data-label="Statut">
					<span class="badge bg-{{ vehicle.status.badge }}">
						{{ vehicle.status.label }}
					</span>
				</td>

				<td data-label="Immatriculation">
					<span>{{ vehicle.registrationNumber }}</span>
				</td>

				<td data-label="Marque">
					<span>{{ vehicle.vehicleModel.brand.name }}</span>
				</td>

				<td data-label="Modèle">
					<span>{{ vehicle.vehicleModel.model.name }}</span>
				</td>

				<td data-label="Kilométrage">
					<span class="text-right">
						{{ vehicle.mileage|number_format(0, ',', '.') }}
						km
					</span>
				</td>

				<td data-label="Carrosserie">
					<span>{{ vehicle.vehicleModel.bodyType.name }}</span>
				</td>

				<td data-label="Énergie">
					<span>{{ vehicle.vehicleModel.fuelType.name }}</span>
				</td>

				<td data-label="Prix">
					<span class="text-right">
						{{ vehicle.price|number_format(0, ',', '.') }}
						€
					</span>
				</td>
			</tr>
		{% else %}
			<tr>
				<td colspan="8" class="text-center">Aucun véhicule trouvé</td>
			</tr>
		{% endfor %}
	</tbody>
</table>
