<div class="table-wrapper">

<table>
	<thead>
		<tr>
			<th>statut</th>
			<th>marque</th>
			<th>modele</th>
			<th>kilometrage</th>
			<th>carrosserie</th>
			<th>energie</th>
			<th>prix</th>

			{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
				<th>immatriculation</th>
				<th>stock</th>
				<th>disponibilite</th>
				<th>cree le</th>
			{% endif %}
		</tr>
	</thead>

	<tbody>
		{% for vehicle in vehicles %}
			<tr>

				<td data-label="statut">
					<span class="badge bg-{{ vehicle.status.badge }}">
						{{ vehicle.status.label }}
					</span>
				</td>

				<td data-label="marque">
					<strong>{{ vehicle.vehicleModel.brand.name }}</strong>
				</td>

				<td data-label="modele">
					{{ vehicle.vehicleModel.model.name }}
				</td>

				<td data-label="kilometrage">
					{{ vehicle.mileage|number_format(0, ',', '.') }} km
				</td>

				<td data-label="carrosserie">
					{{ vehicle.vehicleModel.bodyType.name }}
				</td>

				<td data-label="energie">
					{{ vehicle.vehicleModel.fuelType.name }}
				</td>

				<td data-label="prix">
					{{ vehicle.price|number_format(0, ',', '.') }} €
				</td>

				{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}

					<td data-label="immatriculation">
						{{ vehicle.registrationNumber ?? '-' }}
					</td>

					<td data-label="stock">
						<span class="badge bg-{{ vehicle.status.badge }}">
							{{ vehicle.status.label }}
						</span>
					</td>

					<td data-label="disponibilite">

						{% if vehicle.status.isAvailable %}
							<span class="badge bg-success">disponible</span>

						{% elseif vehicle.status.isReserved %}
							<span class="badge bg-warning text-dark">reserve</span>

						{% elseif vehicle.status.isInUse %}
							<span class="badge bg-info">en utilisation</span>

						{% elseif vehicle.status.isUnavailable %}
							<span class="badge bg-danger">indisponible</span>

						{% else %}
							<span class="badge bg-secondary">-</span>
						{% endif %}

					</td>

					<td data-label="cree le">
						{{ vehicle.createdAt ? vehicle.createdAt|date('d/m/Y') : '-' }}
					</td>

				{% endif %}

			</tr>

		{% else %}

			<tr>
				<td colspan="{{ is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') ? 11 : 7 }}"
					class="text-center text-muted">

					aucun vehicule trouvé

				</td>
			</tr>

		{% endfor %}
	</tbody>
</table>

</div>