<div class="cards-grid">
	{% for vehicle in vehicles %}
		<div
			class="vehicle-card card">

			{# Image du véhicule avec bouton favoris overlay #}
			<div class="vehicle-image-wrapper">
				<img src="#" alt="coverImg {{ vehicle.vehicleModel.model.name }}">
				<button data-action="toggle-favorite" data-url="/vehicle/{{ vehicle.id }}/favorite" class="favorite-btn" aria-pressed="false">
					<i class="fa-regular fa-heart" data-icon></i>
				</button>
			</div>
			<div class="vehicle-card-header">
				<span class="vehicle-brand">
					{{vehicle.vehicleModel.brand.name}}
				</span>
				<span class="vehicle-model">
					{{ vehicle.vehicleModel.model.name }}
				</span>
			</div>
			{# Tableau des spécifications #}
			<div class="vehicle-card-body">
				<table class="vehicle-specs">
					<tbody>
						<tr>
							<th>Statut</th>
							<td data-label="Statut">{{ vehicle.status.label }}</td>
						</tr>

						{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
							<tr>
								<th>Immatriculation</th>
								<td data-label="Immatriculation">{{ vehicle.registrationNumber }}</td>
							</tr>
						{% endif %}

						<tr>
							<th>Kilométrage</th>
							<td data-label="Kilométrage">{{ vehicle.mileage|number_format(0, ',', ' ') }}
								km</td>
						</tr>
						<tr>
							<th>Carrosserie</th>
							<td data-label="Carrosserie">{{ vehicle.vehicleModel.bodyType.name }}</td>
						</tr>
						<tr>
							<th>Énergie</th>
							<td data-label="Énergie">{{ vehicle.vehicleModel.fuelType.name }}</td>
						</tr>
						<tr>
							<th>Prix</th>
							<td data-label="Prix">{{ vehicle.price|number_format(0, ',', ' ') }}
								€</td>
						</tr>
						<tr>
							<th>Mois/Année</th>
							<td data-label="Mois/Année">{{ vehicle.firstRegistrationDate|date("m/Y") }}</td>
						</tr>
					</tbody>
				</table>
			</div>

			{# Liste compacte des options du véhicule #}
			{% set allFeatures = vehicle.features|map(f => f.label) %}
			{% set maxVisible = 5 %}
			{% set visibleFeatures = allFeatures|slice(0, maxVisible) %}
			{% set hiddenCount = allFeatures|length - maxVisible %}

			<p class="vehicle-features">
				Options ({{ allFeatures|length }}):
				{{ visibleFeatures|join(', ') }}
				{% if hiddenCount > 0 %}
					, +{{ hiddenCount }}
					autres…
				{% endif %}
			</p>

		</div>
	{% else %}
		<div class="text-center text-muted">Aucun véhicule trouvé</div>
	{% endfor %}
</div>
