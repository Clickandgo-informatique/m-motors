{% for vehicle in vehicles %}
	<div class="card vehicle-card
		{% if not vehicle.status.isAvailable and (is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER')) %}
		is-unavailable
		{% endif %}
	">
		<div
			class="vehicle-card-header">
			{# lien vers la fiche véhicule (navigation principale) #}
			<a href="{{ path('vehicle_show', {id: vehicle.id}) }}" class="vehicle-card-link-overlay" aria-label="voir le véhicule" data-ajax-modal><i class="fa-solid fa-eye"></i>Voir</a>


			<span class="vehicle-brand" data-label="marque">
				{{ vehicle.vehicleModel.brand.name }}
			</span>

			<span class="vehicle-model" data-label="modèle">
				{{ vehicle.vehicleModel.model.name }}
			</span>
		</div>

		<div class="vehicle-image-wrapper">

			{% if vehicle.images|length > 0 %}
				<img src="{{ asset('uploads/' ~ vehicle.images|first.imagePath) }}" alt="{{ vehicle.vehicleModel.brand.name }} {{ vehicle.vehicleModel.model.name }}" class="vehicle-image" loading="lazy">
			{% endif %}

			<button data-action="toggle-favorite" data-url="/vehicle/{{ vehicle.id }}/favorite" class="favorite-btn" aria-pressed="false" data-label="favori">
				<i class="fa-regular fa-heart" data-icon></i>
			</button>

			{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
				<div class="vehicle-status-badges">

					{% if not vehicle.status.isAvailable %}
						<span class="badge badge-sm bg-danger" data-label="action">
							indisponible
						</span>
					{% endif %}

					<span class="badge badge-sm bg-{{ vehicle.status.badge }}" data-label="statut">
						{{ vehicle.status.label }}
					</span>

				</div>
			{% endif %}

		</div>

		<div class="vehicle-card-actions">

			{% if vehicle.status.isAvailable %}

				{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}

					<a href="{{ path('dossier_create_modal', { id: vehicle.id, type: vehicle.usageType.value == 'rent' ? 'rental' : 'purchase' }) }}"  class="btn btn-primary" data-ajax-modal>

						<i class="fa-solid fa-folder-plus"></i>
						choisir ...
					</a>

				{% else %}

					{% if app.user %}

						<a href="{{ path('dossier_create_modal', { id: vehicle.id, type: vehicle.usageType.value == 'rent' ? 'rental' : 'purchase' }) }}"  class="btn btn-primary btn-sm" data-ajax-modal>

							<i class="fa-solid fa-folder-plus"></i>
							choisir ...
						</a>

					{% else %}

						<a href="{{ path('app_login') }}" class="btn btn-primary btn-sm">

							<i class="fa-solid fa-user"></i>
							Se connecter pour choisir
						</a>

					{% endif %}

				{% endif %}

			{% endif %}

		</div>

		<div class="vehicle-card-body">

			<div class="table-wrapper">
				<table class="vehicle-specs">
					<tbody>

						{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
							<tr>
								<th>immatriculation</th>
								<td>
									{{ vehicle.registrationNumber }}
								</td>
							</tr>
						{% endif %}

						<tr>
							<th>kilométrage</th>
							<td>
								{{ vehicle.mileage|number_format(0, ',', ' ') }}
								km
							</td>
						</tr>

						<tr>
							<th>carrosserie</th>
							<td>
								{{ vehicle.vehicleModel.bodyType.name }}
							</td>
						</tr>

						<tr>
							<th>énergie</th>
							<td>
								{{ vehicle.vehicleModel.fuelType.name }}
							</td>
						</tr>

						<tr>
							<th>prix</th>
							<td>
								{{ vehicle.price|number_format(0, ',', ' ') }}
								€
							</td>
						</tr>

						<tr>
							<th>mois/année</th>
							<td>
								{{ vehicle.firstRegistrationDate|date('m/Y') }}
							</td>
						</tr>

					</tbody>
				</table>
			</div>

		</div>

		{% set allFeatures = vehicle.vehicleModel.features|map(f => f.label) %}
		{% set maxVisible = 5 %}
		{% set visibleFeatures = allFeatures|slice(0, maxVisible) %}
		{% set hiddenCount = allFeatures|length - maxVisible %}

		<p class="vehicle-features">
			options ({{ allFeatures|length }}) :
			{{ visibleFeatures|join(', ') }}

			{% if hiddenCount > 0 %}
				+{{ hiddenCount }}
				autres…
			{% endif %}
		</p>

	</div>

{% else %}

	<div class="text-center text-muted">
		aucun véhicule trouvé
	</div>

{% endfor %}
