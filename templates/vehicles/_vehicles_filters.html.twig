{# templates/vehicles/_vehicles_filters.html.twig #}
<form
	id="filters-form" data-fetch-form data-fetch-url="{{ path('vehicles_search') }}">
	{# Marques #}
	{% if brands|length > 0 %}
		<details>
			<summary>Marque</summary>
			<ul class="brand-list">
				{% for brand in brands %}
					<li>
						<input type="checkbox" name="filters[brand][]" id="brand-{{ brand.id }}" value="{{ brand.id }}">
						<label for="brand-{{ brand.id }}">{{ brand.name }}</label>
					</li>
				{% endfor %}
			</ul>
		</details>
	{% endif %}

	{# Carrosserie #}
	{% if bodyTypes|length > 0 %}
		<details>
			<summary>Carrosserie</summary>
			<ul class="bodyType-list">
				{% for bodyType in bodyTypes %}
					<li>
						<input type="checkbox" name="filters[bodyType][]" id="bodyType-{{ bodyType.id }}" value="{{ bodyType.id }}">
						<label for="bodyType-{{ bodyType.id }}">{{ bodyType.name }}</label>
					</li>
				{% endfor %}
			</ul>
		</details>
	{% endif %}

	{# Carburant #}
	{% if fuelTypes|length > 0 %}
		<details>
			<summary>Carburant</summary>
			<ul class="fuelType-list">
				{% for fuelType in fuelTypes %}
					<li>
						<input type="checkbox" name="filters[fuelType][]" id="fuel-{{ fuelType.id }}" value="{{ fuelType.id }}">
						<label for="fuel-{{ fuelType.id }}">{{ fuelType.name }}</label>
					</li>
				{% endfor %}
			</ul>
		</details>
	{% endif %}

	{# Slider Kilométrage #}
	<div class="mileage-range wrapper">
		<div>
			Kilométrage :
			<span id="mileage-min-value">0</span>
			km -
			<span id="mileage-max-value">300 000</span>
			km
		</div>
		<div class="double-slider" data-filter="mileage" data-min="0" data-max="300000" data-step="10000" data-value-low="0" data-value-high="300000"></div>
		<input type="hidden" name="filters[mileageMin]" value="0">
		<input type="hidden" name="filters[mileageMax]" value="300000">
	</div>

	{# Container badges #}
	<div id="filters-summary" data-target="filters-summary">
		<p class="text-center text-muted">Aucun filtre appliqué</p>
	</div>
</form>
