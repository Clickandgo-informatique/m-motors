{# Components/Forms/_fetch_form.html.twig #}
{# ==========================
   Formulaire AJAX / Autocomplete
   ========================== #}

{# 
  - action : URL AJAX pour FetchForm / Autocomplete
  - resultDiv : container du dropdown autocomplete
  - cardsContainer : container des cards pour la galerie
  - itemClass / linkClass : classes CSS pour chaque item / link
  - itemUrl : URL de l'item pour link / modal
  - resultLinks : si les items doivent être cliquables
  - ajaxModal : ouvrir le link en modal si true
  - autocomplete : activer autocomplete (dropdown)
  - pagination : scroll infini pour autocomplete seulement
  - highlight : surligner le texte correspondant
#}

	<form method="get" action="{{ action|default('') }}" class="fetch-form" data-fetch-form data-url="{{ action|default('') }}" data-result-div="{{ resultDiv|default('autocomplete-results') }}" data-cards-container="{{ cardsContainer|default('vehicles-search-results') }}" data-item-class="{{ itemClass|default('vehicle-item') }}" data-link-class="{{ linkClass|default('vehicle-link') }}" data-no-results-class="{{ noResultsClass|default('dropdown-no-results') }}" data-item-url="{{ itemUrl|default('') }}" data-result-links="{{ resultLinks|default(true) ? 'true' : 'false' }}" data-ajax-modal="{{ ajaxModal|default(false) ? 'true' : 'false' }}" data-autocomplete="{{ autocomplete|default(true) ? 'true' : 'false' }}" data-pagination="{{ pagination|default(false) ? 'true' : 'false' }}" data-highlight="{{ highlight|default(false) ? 'true' : 'false' }}"> <div
		class="form-row dropdown-wrapper">

		{# INPUT AUTOCOMPLETE + SEARCH #}
		<input
		type="text" name="{{ name|default('q') }}" placeholder="{{ placeholder|default('Rechercher...') }}" autocomplete="off" id="autocomplete-input" data-autocomplete="true" data-url="{{ action|default('') }}" data-result-div="{{ resultDiv|default('autocomplete-results') }}" data-cards-container="{{ cardsContainer|default('vehicles-search-results') }}" data-item-url="{{ itemUrl|default('') }}" data-result-links="{{ resultLinks|default(true) ? 'true' : 'false' }}" data-pagination="{{ pagination|default(false) ? 'true' : 'false' }}" data-highlight="{{ highlight|default(false) ? 'true' : 'false' }}"/>

		{# bouton fallback manuel #}
		<button type="button" class="search-toggle-btn" data-search-toggle>
			Rechercher
		</button>

		{# dropdown autocomplete UNIQUEMENT #}
		<div id="{{ resultDiv|default('autocomplete-results') }}" class="{{ dropdownClass|default('dropdown-results') }}"></div>

	</div>
</form>
