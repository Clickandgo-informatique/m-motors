{% set fetchUrl = fetchUrl|default(action) %}
{% set target = target|default('') %}
{% set fetchMode = fetchMode|default('html') %}
{% set filtersTarget = filtersTarget|default('') %}
{% set paginationTop = paginationTop|default('') %}
{% set paginationBottom = paginationBottom|default('') %}
{% set linkMode = linkMode|default(0) %}
{% set hiddenName = hiddenName|default(name ~ 'Id') %}

<form
    method="get"
    action="{{ action }}"
    data-module="fetch-form"
    data-fetch-url="{{ fetchUrl }}"
    data-target="{{ target }}"
    data-fetch-mode="{{ fetchMode }}"
    data-filters-target="{{ filtersTarget }}"
    data-pagination-top="{{ paginationTop }}"
    data-pagination-bottom="{{ paginationBottom }}"
    class="fetch-form"
>

    <div class="form-row dropdown-wrapper">

        <input
            type="text"
            name="{{ name }}"
            value="{{ app.request.get(name) }}"
            placeholder="{{ placeholder }}"
            autocomplete="off"
            data-module="autocomplete"
            data-url="{{ autocompleteUrl }}"
            data-base-url="{{ baseUrl }}"
            data-link-mode="{{ linkMode }}"
            class="search-input"
        >

        <input
            type="hidden"
            name="{{ hiddenName }}"
            data-autocomplete-value
            class="js-autocomplete-hidden"
        >

        <div id="{{ resultDiv }}" class="dropdown-results"></div>

    </div>

</form>