<form
    method="get"
    action="{{ action }}"
    data-module="fetch-form"
    data-fetch-url="{{ fetchUrl }}"
    data-target="{{ target|default('') }}"
    data-fetch-mode="{{ fetchMode|default('html') }}"
    data-filters-target="{{ filtersTarget|default('') }}"
    data-pagination-top="{{ paginationTop|default('') }}"
    data-pagination-bottom="{{ paginationBottom|default('') }}"
    class="fetch-form"
>

	<div class="form-row dropdown-wrapper">

		<input
			type="text"
			name="{{ name }}"
			value="{{ app.request.get(name) }}"
			placeholder="{{ placeholder }}"
			autocomplete="off"
			data-module="autocomplete"
			data-url="{{ autocompleteUrl }}"
			data-base-url="{{ baseUrl }}"
			data-link-mode="{{ linkMode|default(0) }}"
			class="search-input"
		>

		<input
			type="hidden"
			name="{{ hiddenName|default(name ~ 'Id') }}"
			data-autocomplete-value
			class="js-autocomplete-hidden"
		>

		<div id="{{ resultDiv }}" class="dropdown-results"></div>

	</div>

</form>