{% set linkMode = linkMode|default(0) %}
{% set hiddenName = hiddenName|default(name ~ 'Id') %}

<div class="autocomplete">

    <div class="dropdown-wrapper">

        <input
            type="text"
            name="{{ name }}"
            value="{{ app.request.get(name) }}"
            placeholder="{{ placeholder }}"
            autocomplete="off"
            data-module="autocomplete"
            data-url="{{ autocompleteUrl }}"
            data-base-url="{{ baseUrl }}"
            data-link-mode="{{ linkMode }}"
            class="search-input"
        >

        <input
            type="hidden"
            name="{{ hiddenName }}"
            data-autocomplete-value
            class="js-autocomplete-hidden"
        >

        <button
                type="button"
                class="search-reset"
                data-reset-filters               
            >
                <i class="fa-solid fa-rotate-left"></i>
        </button>

        <ul
            id="{{ resultDiv }}"
            class="dropdown-results"
        ></ul>

    </div>

</div>